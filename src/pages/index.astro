---
import Layout from '../layouts/Layout.astro';
import { content, type Locale } from '../i18n/content';

interface Props {
	locale?: Locale;
}

const locale = Astro.props.locale ?? 'id';
const t = content[locale];
const benefits = t.benefits;
const packages = t.packages;
const templates = t.templates;
const faqs = t.faqs;
const testimonials = t.testimonials;
const reversedTestimonials = [...testimonials].reverse();
const languageLinks = locale === 'id'
	? { current: 'ID', other: 'EN', currentHref: '/', otherHref: '/en/' }
	: { current: 'EN', other: 'ID', currentHref: '/en/', otherHref: '/' };

const partners = [
	{ name: `${t.partners.name} 01`, mark: 'M01' },
	{ name: `${t.partners.name} 02`, mark: 'M02' },
	{ name: `${t.partners.name} 03`, mark: 'M03' },
	{ name: `${t.partners.name} 04`, mark: 'M04' },
	{ name: `${t.partners.name} 05`, mark: 'M05' },
	{ name: `${t.partners.name} 06`, mark: 'M06' },
];
---

<Layout lang={locale} title={t.meta.title} description={t.meta.description}>
	<header class="site-header">
		<a class="brand" href="#top" aria-label={`Prasetya Webworks — ${t.footer.back}`}><img src="/images/prasetya-webworks-logo.png" alt="Prasetya Webworks" width="260" height="90" /></a>
		<nav class="desktop-nav" aria-label="Main navigation"><a href="#tentang">{t.nav.about}</a><a href="#layanan">{t.nav.services}</a><a href="#paket">{t.nav.packages}</a><a href="#karya">{t.nav.work}</a><a href="#faq">{t.nav.faq}</a></nav>
		<div class="header-actions"><nav class="language-switcher" aria-label="Language"><a class="active" href={languageLinks.currentHref} aria-current="page">{languageLinks.current}</a><span aria-hidden="true">/</span><a href={languageLinks.otherHref}>{languageLinks.other}</a></nav><a class="header-cta" href="#kontak"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i><span>{t.nav.consultation}</span></a></div>
		<div class="mobile-actions">
			<nav class="mobile-header-languages" aria-label="Language"><a class={locale === 'id' ? 'active' : ''} href="/" aria-current={locale === 'id' ? 'page' : undefined}>ID</a><span aria-hidden="true">/</span><a class={locale === 'en' ? 'active' : ''} href="/en/" aria-current={locale === 'en' ? 'page' : undefined}>EN</a></nav>
			<details class="mobile-nav">
				<summary aria-label={t.nav.menu}><span class="hamburger-icon" aria-hidden="true"><i></i><i></i><i></i></span></summary>
				<div class="mobile-panel"><a href="#tentang">{t.nav.about}</a><a href="#layanan">{t.nav.services}</a><a href="#paket">{t.nav.packages}</a><a href="#karya">{t.nav.work}</a><a href="#faq">{t.nav.faq}</a><a href="#kontak"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i><span>{t.nav.consultation}</span></a></div>
			</details>
		</div>
	</header>

	<main id="top" data-email-status={t.status.email} data-package-subject={t.status.packageSubject} data-consultation-subject={t.status.consultationSubject} data-package-label={t.status.package} data-name-label={t.status.name} data-business-label={t.status.business} data-needs-label={t.status.needs} data-topic-label={t.status.topic}>
		<section class="hero">
			<img class="hero-visual" src="/images/hero-studio-dark-v2.webp" alt="" width="1672" height="941" fetchpriority="high" aria-hidden="true" />
			<div class="hero-shade"></div>
			<div class="hero-content">
				<h1><span><strong>{t.hero.lead}</strong>{t.hero.connector}</span><span>{t.hero.secondLine} <strong><em>{t.hero.emphasis}</em></strong></span></h1>
				<p class="hero-copy">{t.hero.body}</p>
				<div class="hero-actions"><a class="button button-light" href="#kontak">{t.hero.primary} <span>↗</span></a><a class="button button-outline" href="#karya">{t.hero.secondary} <span>↓</span></a></div>
			</div>
		</section>

		<div class="content-shell" id="tentang">
			<section class="partner-strip" aria-labelledby="partner-title">
				<div class="partner-heading"><h2 id="partner-title">{t.partners.title} <em>{t.partners.emphasis}</em></h2><p>{t.partners.description}</p></div>
				<div class="partner-marquee" tabindex="0" aria-label={t.partners.aria}>
					<div class="partner-track">
						<div class="partner-group">{partners.map((partner, index) => <div class="partner-item"><span class:list={['partner-mark', `partner-mark-${(index % 3) + 1}`]} aria-hidden="true">{partner.mark}</span><strong>{partner.name}</strong></div>)}</div>
						<div class="partner-group" aria-hidden="true">{partners.map((partner, index) => <div class="partner-item"><span class:list={['partner-mark', `partner-mark-${(index % 3) + 1}`]}>{partner.mark}</span><strong>{partner.name}</strong></div>)}</div>
					</div>
				</div>
			</section>

			<section class="benefits section-pad" id="layanan" aria-labelledby="benefit-title">
				<div class="section-intro centered"><h2 id="benefit-title">{t.benefitsIntro.title} <em>{t.benefitsIntro.emphasis}</em></h2><p>{t.benefitsIntro.description}</p></div>
				<div class="benefit-grid">{benefits.map((benefit, index) => <article class="benefit-card"><div class="benefit-media"><img src={benefit.image} alt="" loading={index > 1 ? 'lazy' : 'eager'} style={`object-position:${benefit.position}`} /></div><div class="benefit-copy"><h3>{benefit.title}</h3><p>{benefit.text}</p></div></article>)}</div>
			</section>

			<section class="pricing section-pad" id="paket" aria-labelledby="pricing-title">
				<div class="section-intro centered"><h2 id="pricing-title">{t.pricingIntro.title} <em>{t.pricingIntro.emphasis}</em></h2><p>{t.pricingIntro.description}</p></div>
				<div class="pricing-grid">{packages.map((item) => <article class:list={['pricing-card', { featured: 'featured' in item && item.featured }]}><div><h3>{item.name}</h3><p>{item.tagline}</p></div><ul>{item.features.map((feature) => <li><span aria-hidden="true">✓</span>{feature}</li>)}</ul><button class="package-select" type="button" data-package-name={item.name} data-package-tagline={item.tagline}>{t.pricingIntro.select} <span aria-hidden="true">↗</span></button></article>)}</div>
			</section>

			<section class="templates section-pad" id="karya" aria-labelledby="template-title">
				<div class="section-intro centered"><h2 id="template-title">{t.templatesIntro.title} <em>{t.templatesIntro.emphasis}</em></h2><p>{t.templatesIntro.description}</p></div>
				<div class="template-grid">{templates.map((item, index) => <article class="template-card"><div class:list={['template-screen', item.className]}><div class="mini-nav"><span>●</span><i></i><i></i><i></i></div><div class="mini-copy"><strong>{item.headline}</strong><span>{t.templatesIntro.action} <b>↗</b></span></div><div class="mini-art"><i></i><i></i><i></i></div><span class="template-index">0{index + 1}</span></div><div class="template-meta"><h3>{item.title}</h3><p>{item.caption}</p></div></article>)}</div>
			</section>

			<section class="faq section-pad" id="faq" aria-labelledby="faq-title">
				<div class="section-intro centered"><h2 id="faq-title">{t.faqTitle.title} <em>{t.faqTitle.emphasis}</em></h2></div>
				<div class="faq-list">{faqs.map((faq) => <details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div>
			</section>

			<section class="contact section-pad" id="kontak" aria-labelledby="contact-title">
				<form class="contact-form" id="contact-form">
					<h2 id="contact-title">{t.contact.title}</h2><p>{t.contact.description}</p>
					<div class="field-row"><label>{t.contact.name}<input name="name" type="text" placeholder={t.contact.namePlaceholder} required /></label><label>{t.contact.email}<input name="email" type="email" placeholder="nama@email.com" required /></label></div>
					<label>{t.contact.topic}<select name="topic" required><option value="">{t.contact.topicPlaceholder}</option>{t.contact.topics.map((topic) => <option>{topic}</option>)}</select></label>
					<label>{t.contact.message}<textarea name="message" rows="5" placeholder={t.contact.messagePlaceholder} required></textarea></label>
					<button type="submit">{t.contact.submit} <span aria-hidden="true">↗</span></button><p class="form-status" role="status" aria-live="polite"></p>
				</form>
				<section class="testimonial-panel" aria-labelledby="testimonials-title">
					<div class="testimonial-heading"><h2 id="testimonials-title">{t.testimonialsIntro.title} <em>{t.testimonialsIntro.emphasis}</em></h2><p>{t.testimonialsIntro.description}</p></div>
					<div class="testimonial-marquees" aria-label={t.testimonialsIntro.aria}>
						<div class="testimonial-marquee testimonial-marquee-left">
							<div class="testimonial-track">
								<div class="testimonial-group">{testimonials.map((testimonial, index) => <article class="testimonial-card"><header><span class:list={['client-avatar', `avatar-${(index % 3) + 1}`]} aria-hidden="true"></span><div><strong>{testimonial.name}</strong><p>{testimonial.role}</p></div></header><div class="stars" role="img" aria-label={t.testimonialsIntro.rating}><span aria-hidden="true">★★★★★</span></div><blockquote>“{testimonial.quote}”</blockquote></article>)}</div>
								<div class="testimonial-group" aria-hidden="true">{testimonials.map((testimonial, index) => <article class="testimonial-card"><header><span class:list={['client-avatar', `avatar-${(index % 3) + 1}`]}></span><div><strong>{testimonial.name}</strong><p>{testimonial.role}</p></div></header><div class="stars"><span>★★★★★</span></div><blockquote>“{testimonial.quote}”</blockquote></article>)}</div>
							</div>
						</div>
						<div class="testimonial-marquee testimonial-marquee-right">
							<div class="testimonial-track">
								<div class="testimonial-group">{reversedTestimonials.map((testimonial, index) => <article class="testimonial-card"><header><span class:list={['client-avatar', `avatar-${((index + 1) % 3) + 1}`]} aria-hidden="true"></span><div><strong>{testimonial.name}</strong><p>{testimonial.role}</p></div></header><div class="stars" role="img" aria-label={t.testimonialsIntro.rating}><span aria-hidden="true">★★★★★</span></div><blockquote>“{testimonial.quote}”</blockquote></article>)}</div>
								<div class="testimonial-group" aria-hidden="true">{reversedTestimonials.map((testimonial, index) => <article class="testimonial-card"><header><span class:list={['client-avatar', `avatar-${((index + 1) % 3) + 1}`]}></span><div><strong>{testimonial.name}</strong><p>{testimonial.role}</p></div></header><div class="stars"><span>★★★★★</span></div><blockquote>“{testimonial.quote}”</blockquote></article>)}</div>
							</div>
						</div>
					</div>
					<p class="testimonial-note">{t.testimonialsIntro.note}</p>
				</section>
			</section>
		</div>

		<dialog class="package-modal" id="package-modal" aria-labelledby="package-modal-title">
			<div class="package-modal-shell">
				<button class="modal-close" type="button" data-modal-close aria-label={t.modal.close}>×</button>
				<section class="package-summary" aria-label={t.modal.detail}>
					<h2 id="package-modal-title" data-modal-package-name>Essential</h2>
					<p class="package-summary-copy" data-modal-package-tagline></p>
					<div class="summary-divider"></div>
					<p class="summary-title">{t.modal.included}</p>
					<ul data-modal-package-features></ul>
					<p class="summary-note">{t.modal.note}</p>
				</section>
				<form class="package-order-form" id="package-order-form">
					<h2>{t.modal.title}</h2>
					<p>{t.modal.description}</p>
					<input type="hidden" name="package" data-package-input />
					<div class="field-row"><label>{t.modal.name}<input name="name" type="text" placeholder={t.modal.namePlaceholder} required /></label><label>{t.modal.whatsapp}<input name="whatsapp" type="tel" placeholder="08xxxxxxxxxx" required /></label></div>
					<label>{t.modal.email}<input name="email" type="email" placeholder="nama@email.com" required /></label>
					<label>{t.modal.business} <span>{t.modal.optional}</span><input name="business" type="text" placeholder={t.modal.businessPlaceholder} /></label>
					<label>{t.modal.needs}<textarea name="message" rows="4" placeholder={t.modal.needsPlaceholder} required></textarea></label>
					<button class="order-submit" type="submit">{t.modal.submit} <span aria-hidden="true">↗</span></button>
					<p class="order-status" role="status" aria-live="polite"></p>
				</form>
			</div>
		</dialog>
	</main>

	<footer class="site-footer">
		<div class="footer-main"><div class="footer-brand"><img src="/images/prasetya-webworks-logo.png" alt="Prasetya Webworks" width="260" height="90" /></div><div><span>{t.footer.hours}</span><p>{t.footer.weekdays}<br />{t.footer.saturday}</p></div><div><span>{t.footer.contact}</span><p>hello@prasetyawebworks.com<br />Indonesia</p></div><nav aria-label="Footer navigation"><a href="#tentang">{t.nav.about}</a><a href="#layanan">{t.nav.services}</a><a href="#paket">{t.nav.packages}</a><a href="#karya">{t.nav.work}</a><a href="#faq">{t.nav.faq}</a></nav></div>
		<div class="footer-bottom"><span>© {new Date().getFullYear()} Prasetya Webworks. {t.footer.rights}</span><a href="#top">{t.footer.back} ↑</a></div>
	</footer>

		<script>
			const page = document.querySelector<HTMLElement>('main');
			const labels = page?.dataset;
			const packageModal = document.querySelector<HTMLDialogElement>('#package-modal');
			const packageCards = Array.from(document.querySelectorAll<HTMLElement>('.pricing-card'));
			const packageName = packageModal?.querySelector<HTMLElement>('[data-modal-package-name]');
			const packageTagline = packageModal?.querySelector<HTMLElement>('[data-modal-package-tagline]');
			const packageFeatures = packageModal?.querySelector<HTMLUListElement>('[data-modal-package-features]');
			const packageInput = packageModal?.querySelector<HTMLInputElement>('[data-package-input]');

			packageCards.forEach((card) => {
				card.querySelector<HTMLButtonElement>('.package-select')?.addEventListener('click', () => {
					const selectedName = card.querySelector('h3')?.textContent?.trim() ?? '';
					const selectedTagline = card.querySelector('p')?.textContent?.trim() ?? '';
					const selectedFeatures = Array.from(card.querySelectorAll('li')).map((item) => item.textContent?.replace('✓', '').trim() ?? '');

					if (packageName) packageName.textContent = selectedName;
					if (packageTagline) packageTagline.textContent = selectedTagline;
					if (packageInput) packageInput.value = selectedName;
					if (packageFeatures) packageFeatures.innerHTML = selectedFeatures.map((feature) => `<li><span aria-hidden="true">✓</span>${feature}</li>`).join('');
					packageModal?.showModal();
				});
			});

			packageModal?.querySelector('[data-modal-close]')?.addEventListener('click', () => packageModal.close());
			packageModal?.addEventListener('click', (event) => {
				if (event.target === packageModal) packageModal.close();
			});

			const packageOrderForm = document.querySelector<HTMLFormElement>('#package-order-form');
			packageOrderForm?.addEventListener('submit', (event) => {
				event.preventDefault();
				const data = new FormData(packageOrderForm);
				const subject = encodeURIComponent(`${labels?.packageSubject ?? ''} ${data.get('package') ?? ''}`);
				const body = encodeURIComponent(`${labels?.packageLabel}: ${data.get('package')}\n${labels?.nameLabel}: ${data.get('name')}\nWhatsApp: ${data.get('whatsapp')}\nEmail: ${data.get('email')}\n${labels?.businessLabel}: ${data.get('business') || '-'}\n\n${labels?.needsLabel}:\n${data.get('message')}`);
				window.location.href = `mailto:hello@prasetyawebworks.com?subject=${subject}&body=${body}`;
				const status = packageOrderForm.querySelector<HTMLElement>('.order-status');
				if (status) status.textContent = labels?.emailStatus ?? '';
			});

			document.querySelectorAll('.mobile-panel a').forEach((link) => link.addEventListener('click', () => link.closest('details')?.removeAttribute('open')));
			const form = document.querySelector<HTMLFormElement>('#contact-form');
		form?.addEventListener('submit', (event) => {
			event.preventDefault();
			const data = new FormData(form);
			const subject = encodeURIComponent(`${labels?.consultationSubject ?? ''} — ${data.get('topic') ?? ''}`);
			const body = encodeURIComponent(`${labels?.nameLabel}: ${data.get('name')}\nEmail: ${data.get('email')}\n${labels?.topicLabel}: ${data.get('topic')}\n\n${data.get('message')}`);
			window.location.href = `mailto:hello@prasetyawebworks.com?subject=${subject}&body=${body}`;
			const status = form.querySelector<HTMLElement>('.form-status');
			if (status) status.textContent = labels?.emailStatus ?? '';
		});

		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const revealItems = Array.from(document.querySelectorAll<HTMLElement>([
			'.partner-heading',
			'.section-intro',
			'.benefit-card',
			'.pricing-card',
			'.template-card',
			'.faq-list details',
			'.contact-form',
			'.testimonial-heading',
			'.testimonial-marquees',
			'.footer-main',
			'.footer-bottom',
		].join(',')));

		revealItems.forEach((item, index) => {
			item.classList.add('scroll-reveal');
			item.style.setProperty('--reveal-delay', `${(index % 6) * 65}ms`);
		});

		if (reducedMotion || !('IntersectionObserver' in window)) {
			revealItems.forEach((item) => item.classList.add('is-visible'));
		} else {
			const revealObserver = new IntersectionObserver((entries, observer) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				});
			}, { threshold: 0.12, rootMargin: '0px 0px -7% 0px' });

			revealItems.forEach((item) => revealObserver.observe(item));
		}

		const siteHeader = document.querySelector<HTMLElement>('.site-header');
		const hero = document.querySelector<HTMLElement>('.hero');
		const heroVisual = document.querySelector<HTMLElement>('.hero-visual');
		let scrollFrame: number | null = null;

		const updateScrollEffects = () => {
			siteHeader?.classList.toggle('is-scrolled', window.scrollY > 24);

			if (!reducedMotion && hero && heroVisual) {
				const heroBounds = hero.getBoundingClientRect();
				if (heroBounds.bottom > 0) {
					const shift = Math.min(34, Math.max(0, -heroBounds.top * 0.075));
					heroVisual.style.transform = `translate3d(0, ${shift}px, 0) scale(1.035)`;
				}
			}

			scrollFrame = null;
		};

		window.addEventListener('scroll', () => {
			if (scrollFrame !== null) return;
			scrollFrame = window.requestAnimationFrame(updateScrollEffects);
		}, { passive: true });

		updateScrollEffects();
	</script>
</Layout>

	<style>
		:global(:root) { --ink:#11131a; --ivory:#f4f1ea; --paper:#fffdf8; --blue:#173a9b; --blue-deep:#0b2368; --blue-soft:#d7e0fb; --muted:#6f7180; --line:#d9d5cc; }
		:global(body) { overflow-x: hidden; background:var(--ivory); }
	.site-header { position: fixed; z-index: 30; inset: 0 0 auto; height: 74px; padding: 0 clamp(1.2rem,4vw,4.5rem); display:grid; grid-template-columns:1fr auto 1fr; align-items:center; color:#fff; background:rgba(7,7,7,.84); border-bottom:1px solid rgba(255,255,255,.12); backdrop-filter:blur(16px); }
	.brand { width:132px; height:48px; display:flex; align-items:center; filter:invert(1); }.brand img { width:100%; height:100%; object-fit:contain; object-position:left center; }
	.desktop-nav { display:flex; gap:2rem; }.desktop-nav a,.header-cta { color:inherit; text-decoration:none; font-size:.67rem; letter-spacing:.1em; text-transform:uppercase; }.desktop-nav a { opacity:.72; }.desktop-nav a:hover { opacity:1; }
			.header-actions { justify-self:end; display:flex; align-items:center; gap:.85rem; }.language-switcher { padding:.34rem .48rem; display:flex; align-items:center; gap:.35rem; color:rgba(255,255,255,.52); border:1px solid rgba(255,255,255,.18); border-radius:999px; font-size:.61rem; }.language-switcher a { color:inherit; text-decoration:none; }.language-switcher a:hover,.language-switcher .active { color:#fff; }.language-switcher .active { font-weight:700; }.header-cta { padding:.7rem 1.05rem; display:inline-flex; align-items:center; gap:.52rem; color:#fff; background:var(--blue); border:1px solid var(--blue); border-radius:999px; transition:background .2s,border-color .2s,transform .2s; }.header-cta:hover { background:#244bac; border-color:#244bac; transform:translateY(-1px); }.header-cta i { font-size:.98rem; line-height:1; }
		.mobile-actions { display:none; justify-self:end; align-items:center; gap:.55rem; }
		.mobile-header-languages { padding:.34rem .5rem; display:flex; align-items:center; gap:.35rem; color:rgba(255,255,255,.5); border:1px solid rgba(255,255,255,.18); border-radius:999px; font-size:.6rem; }
		.mobile-header-languages a { color:inherit; text-decoration:none; }.mobile-header-languages a:hover,.mobile-header-languages .active { color:#fff; }.mobile-header-languages .active { font-weight:700; }
		.mobile-nav { display:none; position:relative; }.mobile-nav summary { width:38px; height:38px; display:grid; place-items:center; list-style:none; cursor:pointer; color:#fff; background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.18); border-radius:50%; transition:background .2s,border-color .2s; }.mobile-nav summary:hover { background:rgba(117,144,255,.16); border-color:rgba(117,144,255,.45); }.mobile-nav summary::-webkit-details-marker { display:none; }
		.hamburger-icon { width:16px; height:12px; position:relative; display:block; }.hamburger-icon i { position:absolute; left:0; width:100%; height:1.5px; background:currentColor; border-radius:999px; transition:transform .25s ease,opacity .2s ease,top .25s ease; }.hamburger-icon i:nth-child(1) { top:0; }.hamburger-icon i:nth-child(2) { top:5px; }.hamburger-icon i:nth-child(3) { top:10px; }.mobile-nav[open] .hamburger-icon i:nth-child(1) { top:5px; transform:rotate(45deg); }.mobile-nav[open] .hamburger-icon i:nth-child(2) { opacity:0; }.mobile-nav[open] .hamburger-icon i:nth-child(3) { top:5px; transform:rotate(-45deg); }.mobile-nav[open] summary { background:var(--blue); border-color:var(--blue); }
