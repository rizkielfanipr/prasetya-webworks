---
import TemplateCatalogPage from '../../../../components/TemplateCatalogPage.astro';
import { laterCatalogPages } from '../../../../data/templates';

export function getStaticPaths() {
	return laterCatalogPages().map((page) => ({ params: { page } }));
}
---

<TemplateCatalogPage locale="en" page={Number(Astro.params.page)} />
