---
import TemplateCatalogPage from '../../../components/templates/TemplateCatalogPage.astro';
import { templateCategories, type TemplateCategory } from '../../../data/templates';

export function getStaticPaths() {
	return templateCategories.map((category) => ({ params: { category } }));
}

const category = Astro.params.category as TemplateCategory;
---

<TemplateCatalogPage locale="en" category={category} />
