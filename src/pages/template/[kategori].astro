---
import TemplateCatalogPage from '../../components/TemplateCatalogPage.astro';
import { templateCategories, type TemplateCategory } from '../../data/templates';

export function getStaticPaths() {
	return templateCategories.map((kategori) => ({ params: { kategori } }));
}

const kategori = Astro.params.kategori as TemplateCategory;
---

<TemplateCatalogPage locale="id" category={kategori} />
