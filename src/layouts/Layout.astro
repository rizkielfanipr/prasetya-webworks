---
import '@fortawesome/fontawesome-free/css/fontawesome.css';
import '@fortawesome/fontawesome-free/css/brands.css';
import '../styles/global.css';
import WhatsAppFloat from '../components/layout/WhatsAppFloat.astro';
import { content, type Locale } from '../i18n/content';
import { homePath } from '../data/templates';

interface Props {
	title?: string;
	description?: string;
	lang?: Locale;
	/** Paths of this page in each language, for hreflang links. */
	alternates?: { id: string; en: string };
}

const {
	title = 'Prasetya Webworks — Website yang bekerja untuk bisnis Anda',
	description = 'Prasetya Webworks merancang website profesional, cepat, responsif, dan terarah untuk membantu bisnis tampil lebih meyakinkan.',
	lang = 'id',
	alternates = { id: '/', en: '/en/' },
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#10131d" />
		<link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="alternate" hreflang="id" href={alternates.id} />
		<link rel="alternate" hreflang="en" href={alternates.en} />
		<link rel="alternate" hreflang="x-default" href={alternates.id} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		{/* Every page gets the floating consultation button, pointing at the home contact form. */}
		<WhatsAppFloat href={`${homePath(lang)}#contact`} label={content[lang].nav.consultation} />
	</body>
</html>
