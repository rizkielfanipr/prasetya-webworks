---
import { content, type Locale } from '../i18n/content';
import { livePreviewUrl, type TemplateCategory, type TemplateItem } from '../data/templates';

interface Props {
	item: TemplateItem;
	locale: Locale;
	/** Link target for the select action; without it the card renders a button handled by page script. */
	href?: string;
	hidden?: boolean;
}

const { item, locale, href, hidden = false } = Astro.props;
const t = content[locale].templatesIntro;
const request = t.request.replace('{code}', item.code).replace('{name}', item.name);
const preview = livePreviewUrl(item);
---

<article class="template-card" data-category={item.category} hidden={hidden}>
	<div class="template-screen">
		{item.thumbnail ? <img src={`/images/templates/${item.code}.webp`} alt={t.thumbAlt.replace('{name}', item.name)} width="640" height="400" loading="lazy" decoding="async" /> : <span class="template-placeholder">{item.name}</span>}
		{preview && <span class="template-live"><i aria-hidden="true"></i>{t.liveBadge}</span>}
		<span class="template-index">#{item.code}</span>
	</div>
	<div class="template-meta">
		<span class="template-category">{content[locale].templateCategories[item.category as TemplateCategory]}</span>
		<h3>{item.name}</h3>
		<p>{item.type} · {item.pages} {t.pages}</p>
		<div class="template-actions">
			{preview && <a class="template-preview" href={preview} target="_blank" rel="noopener" aria-label={t.livePreviewLabel.replace('{name}', item.name)}>{t.livePreview} <span aria-hidden="true">↗</span></a>}
			{href
				? <a class="template-select" href={href}>{t.select} <span aria-hidden="true">↗</span></a>
				: <button class="template-select" type="button" data-template-request={request}>{t.select} <span aria-hidden="true">↗</span></button>}
		</div>
	</div>
</article>

<style>
	.template-card { overflow:hidden; background:var(--paper); border:1px solid var(--line); border-radius:20px; box-shadow:0 10px 28px rgba(35,43,80,.05); transition:transform .25s,box-shadow .25s; }.template-card:hover { transform:translateY(-6px); box-shadow:0 24px 45px rgba(25,36,80,.14); }.template-card[hidden] { display:none; }
	.template-screen { position:relative; aspect-ratio:16/10; overflow:hidden; background:#e7ebfa; border-radius:17px 17px 0 0; }.template-screen img { width:100%; height:100%; display:block; object-fit:cover; object-position:top; transition:transform .5s ease; }.template-card:hover .template-screen img { transform:scale(1.03); }
	.template-placeholder { height:100%; display:grid; place-items:center; padding:1rem; color:var(--blue-deep); font-family:Georgia,serif; font-size:1.6rem; text-align:center; }
	.template-index { position:absolute; right:.7rem; bottom:.6rem; z-index:3; padding:.2rem .5rem; color:#fff; background:rgba(17,19,26,.62); border-radius:999px; font-size:.58rem; letter-spacing:.06em; }
	.template-live { position:absolute; left:.7rem; top:.6rem; z-index:3; padding:.25rem .55rem; display:inline-flex; align-items:center; gap:.35rem; color:#0f5132; background:rgba(255,255,255,.92); border-radius:999px; box-shadow:0 4px 12px rgba(17,19,26,.12); font-size:.58rem; font-weight:600; letter-spacing:.08em; text-transform:uppercase; }.template-live i { width:.45rem; height:.45rem; display:block; background:#22c55e; border-radius:50%; box-shadow:0 0 0 3px rgba(34,197,94,.22); }
	.template-meta { padding:1.1rem; text-align:center; }.template-meta h3 { margin:0 0 .35rem; color:var(--ink); font-family:Georgia,serif; font-size:1rem; font-weight:400; }.template-meta p { margin:0; color:var(--muted); font-size:.67rem; line-height:1.45; }
	.template-category { display:block; margin-bottom:.45rem; color:var(--blue); font-size:.58rem; letter-spacing:.12em; text-transform:uppercase; }
	.template-actions { margin-top:.95rem; display:flex; flex-wrap:wrap; justify-content:center; gap:.5rem; }
	.template-select,.template-preview { padding:.55rem .95rem; display:inline-flex; gap:.6rem; border:1px solid var(--blue); border-radius:999px; font:inherit; font-size:.62rem; letter-spacing:.08em; text-decoration:none; text-transform:uppercase; cursor:pointer; transition:background .2s,color .2s,border-color .2s; }
	.template-select { color:var(--blue); background:transparent; }.template-select:hover { color:#fff; background:var(--blue); }
	.template-preview { color:#fff; background:var(--blue); }.template-preview:hover { background:var(--blue-deep); border-color:var(--blue-deep); }
	.template-select:focus-visible,.template-preview:focus-visible { outline:3px solid var(--blue-soft); outline-offset:2px; }
	.template-select span,.template-preview span { transition:transform .25s ease; }.template-select:hover span,.template-preview:hover span { transform:translate3d(3px,-2px,0); }
	@media (prefers-reduced-motion:reduce) { .template-card,.template-screen img,.template-select span,.template-preview span { transition:none; } }
</style>
