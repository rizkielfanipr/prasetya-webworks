---
/**
 * Dark call-to-action banner: eyebrow, two-line heading with a highlighted second line,
 * description, a primary button (globe icon + arrow), a WhatsApp button and a row of highlights.
 */
import { whatsappUrl } from '../../scripts/whatsapp';

interface Props {
	/** id of the heading, referenced by the section's aria-labelledby. */
	id: string;
	eyebrow: string;
	title: string;
	emphasis: string;
	/** Punctuation after the highlighted words, kept outside the highlight. */
	titleEnd?: string;
	description: string;
	primary: { label: string; href: string };
	/** Label and prepared message for the WhatsApp button. */
	whatsapp: { label: string; message: string };
	highlights: string[];
}

const { id, eyebrow, title, emphasis, titleEnd = '', description, primary, whatsapp, highlights } = Astro.props;
---

<div class="cta-banner">
	<p class="cta-eyebrow">{eyebrow}</p>
	<h2 id={id}>
		{title}
		<br />
		<em>{emphasis}</em>
		{titleEnd}
	</h2>
	<p class="cta-description">{description}</p>
	<div class="cta-actions">
		<a class="cta-primary" href={primary.href}>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<circle cx="12" cy="12" r="9"></circle>
				<path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"></path>
			</svg>
			{primary.label}
			<span class="cta-arrow" aria-hidden="true">
				→
			</span>
		</a>
		<a class="cta-secondary" href={whatsappUrl(whatsapp.message)} target="_blank" rel="noopener">
			<i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
			{whatsapp.label}
		</a>
	</div>
	<p class="cta-highlights">{highlights.join(' · ')}</p>
</div>

<style>
	.cta-banner {
		max-width: 1320px;
		margin: auto;
		padding: clamp(3.5rem, 7vw, 6.5rem) clamp(1.5rem, 5vw, 4rem);
		position: relative;
		overflow: hidden;
		isolation: isolate;
		color: var(--primary-foreground);
		text-align: center;
		background:
			radial-gradient(circle at 8% 100%, rgba(255, 81, 0, 0.32), transparent 38%),
			linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px) 0 0 / 64px 64px,
			linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px) 0 0 / 64px 64px,
			var(--foreground);
		border-radius: 24px;
	}

	.cta-eyebrow {
		margin: 0 0 1.6rem;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		color: var(--primary);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.cta-eyebrow::before,
	.cta-eyebrow::after {
		content: '';
		width: 2.5rem;
		height: 1px;
		background: currentColor;
	}

	.cta-banner h2 {
		margin: 0 auto;
		font-family: var(--font-display);
		font-size: clamp(2.3rem, 5vw, 4.4rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1.08;
	}

	/* The emphasis sits on its own line over a highlighter stroke. */
	.cta-banner h2 em {
		padding-inline: 0.12em;
		font-style: italic;
		font-weight: 500;
		background: linear-gradient(transparent 58%, rgba(255, 81, 0, 0.6) 58%, rgba(255, 81, 0, 0.6) 88%, transparent 88%);
		box-decoration-break: clone;
	}

	.cta-description {
		max-width: 620px;
		margin: 1.6rem auto 0;
		color: rgba(255, 255, 255, 0.78);
		font-size: clamp(0.95rem, 1.4vw, 1.12rem);
		line-height: 1.7;
	}

	.cta-actions {
		margin-top: 2.4rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
	}

	.cta-primary,
	.cta-secondary {
		min-height: 56px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		border-radius: var(--radius);
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			transform 180ms ease,
			background-color 180ms ease,
			border-color 180ms ease;
	}

	.cta-primary {
		padding: 0.5rem 0.6rem 0.5rem 1.4rem;
		color: var(--primary-foreground);
		background: var(--primary);
		box-shadow: var(--brand-shadow);
	}

	.cta-primary:hover {
		background: var(--blue-hover);
		transform: translateY(-2px);
	}

	.cta-primary svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
	}

	.cta-arrow {
		width: 38px;
		height: 38px;
		display: grid;
		place-items: center;
		color: var(--primary);
		background: var(--primary-foreground);
		border-radius: 12px;
		transition: transform 180ms ease;
	}

	.cta-primary:hover .cta-arrow {
		transform: translateX(3px);
	}

	.cta-secondary {
		padding: 0.5rem 1.5rem;
		color: var(--primary-foreground);
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.28);
	}

	.cta-secondary:hover {
		background: rgba(255, 255, 255, 0.1);
		border-color: rgba(255, 255, 255, 0.5);
		transform: translateY(-2px);
	}

	.cta-secondary i {
		color: #25d366;
		font-size: 1.25rem;
	}

	.cta-primary:focus-visible,
	.cta-secondary:focus-visible {
		outline: 2px solid var(--primary-foreground);
		outline-offset: 3px;
	}

	.cta-highlights {
		margin: 2.6rem 0 0;
		color: rgba(255, 255, 255, 0.5);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	@media (max-width: 560px) {
		.cta-banner {
			border-radius: var(--radius);
		}

		.cta-actions {
			flex-direction: column;
			align-items: stretch;
		}

		.cta-primary {
			justify-content: space-between;
		}

		.cta-primary svg {
			display: none;
		}

		.cta-highlights {
			letter-spacing: 0.12em;
			line-height: 1.8;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cta-primary,
		.cta-secondary,
		.cta-arrow {
			transition: none;
		}
	}
</style>
