---
/**
 * Numbered pager: first, last, the current page and its neighbours; gaps become an ellipsis.
 * Renders nothing when there is a single page.
 */
interface Props {
	current: number;
	total: number;
	/** URL of a page number. */
	hrefFor: (page: number) => string;
	labels: {
		/** Accessible name of the pager. */
		nav: string;
		previous: string;
		next: string;
		/** Accessible name of a page link, with {page} and {total}. */
		pageOf: string;
	};
}

const { current, total, hrefFor, labels } = Astro.props;
const shown = [...new Set([1, current - 1, current, current + 1, total])].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b);
const items = shown.flatMap((n, index) => (index > 0 && n - shown[index - 1] > 1 ? ['gap', n] : [n])) as (number | 'gap')[];
---

{total > 1 && (
	<nav class="pagination" aria-label={labels.nav}>
		{current > 1 ? (
			<a class="pager-step" href={hrefFor(current - 1)} rel="prev">
				<span aria-hidden="true">‹</span> <span class="pager-label">{labels.previous}</span>
			</a>
		) : (
			<span class="pager-step" aria-hidden="true">
				<span>‹</span> <span class="pager-label">{labels.previous}</span>
			</span>
		)}
		<ol>
			{items.map((item) =>
				item === 'gap' ? (
					<li class="pager-gap" aria-hidden="true">
						…
					</li>
				) : (
					<li>
						<a
							class="pager-number"
							href={hrefFor(item)}
							aria-current={item === current ? 'page' : undefined}
							aria-label={labels.pageOf.replace('{page}', String(item)).replace('{total}', String(total))}
						>
							{item}
						</a>
					</li>
				),
			)}
		</ol>
		{current < total ? (
			<a class="pager-step" href={hrefFor(current + 1)} rel="next">
				<span class="pager-label">{labels.next}</span> <span aria-hidden="true">›</span>
			</a>
		) : (
			<span class="pager-step" aria-hidden="true">
				<span class="pager-label">{labels.next}</span> <span>›</span>
			</span>
		)}
	</nav>
)}

<style>
	.pagination {
		margin-top: 2.6rem;
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	ol {
		margin: 0;
		padding: 0;
		display: flex;
		align-items: center;
		gap: 0.35rem;
		list-style: none;
	}

	.pager-number,
	.pager-step {
		min-width: 2.4rem;
		height: 2.4rem;
		padding: 0 0.85rem;
		display: inline-flex;
		justify-content: center;
		align-items: center;
		gap: 0.4rem;
		color: var(--ink);
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 0.68rem;
		letter-spacing: 0.04em;
		text-decoration: none;
		transition:
			background 0.2s,
			border-color 0.2s,
			color 0.2s;
	}

	.pager-number {
		padding: 0;
	}

	a.pager-number:hover,
	a.pager-step:hover {
		color: var(--blue);
		border-color: var(--blue);
	}

	.pager-number[aria-current] {
		color: #fff;
		background: var(--blue);
		border-color: var(--blue);
	}

	/* Disabled previous/next at the first or last page. */
	span.pager-step {
		color: var(--line);
	}

	.pager-gap {
		padding: 0 0.2rem;
		color: var(--muted);
		font-size: 0.7rem;
	}

	.pager-number:focus-visible,
	.pager-step:focus-visible {
		outline: 3px solid var(--blue-soft);
		outline-offset: 2px;
	}

	@media (max-width: 560px) {
		.pagination {
			flex-wrap: nowrap;
			gap: 0.25rem;
		}
		ol {
			gap: 0.2rem;
		}
		.pager-number,
		.pager-step {
			min-width: 2.1rem;
			height: 2.1rem;
			padding: 0;
		}
		/* Keep only the arrows on small screens; the words stay available to screen readers. */
		.pager-label {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}
	}
</style>
