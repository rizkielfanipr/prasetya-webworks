---
/** Centered section heading: "<title> <em>emphasis</em>" with an optional description. */
interface Props {
	/** id of the heading, referenced by the section's aria-labelledby. */
	id: string;
	title: string;
	emphasis: string;
	description?: string;
}

const { id, title, emphasis, description } = Astro.props;
---

<div class="section-intro">
	<h2 id={id}>
		{title} <em>{emphasis}</em>
	</h2>
	{description && <p>{description}</p>}
</div>

<style>
	.section-intro {
		max-width: 720px;
		margin: 0 auto clamp(3rem, 4.5vw, 4.5rem);
		text-align: center;
	}

	h2 {
		margin: 0;
		color: var(--ink);
		font-family: var(--font-display);
		font-size: clamp(2.1rem, 3.8vw, 4.1rem);
		font-weight: 400;
		letter-spacing: -0.045em;
		line-height: 1;
	}

	h2 em {
		color: var(--blue-deep);
	}

	p {
		max-width: 540px;
		margin: 1rem auto 0;
		color: var(--muted);
		font-size: 0.86rem;
		line-height: 1.6;
	}
</style>
