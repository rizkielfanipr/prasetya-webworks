---
/**
 * Section heading: "<title> <em>emphasis</em>" with an optional description.
 * `center` stacks everything centered; `split` puts a lined eyebrow above a left heading and a right description.
 */
interface Props {
	/** id of the heading, referenced by the section's aria-labelledby. */
	id: string;
	title: string;
	emphasis: string;
	description?: string;
	eyebrow?: string;
	layout?: 'center' | 'split';
}

const { id, title, emphasis, description, eyebrow, layout = 'center' } = Astro.props;
---

{layout === 'split' ? (
	<header class="section-intro section-intro--split">
		{eyebrow && (
			<p class="eyebrow">
				<span aria-hidden="true" />
				{eyebrow}
			</p>
		)}
		<div class="split-grid">
			<h2 id={id}>
				{title} <em>{emphasis}</em>
			</h2>
			{description && <p class="split-description">{description}</p>}
		</div>
	</header>
) : (
	<div class="section-intro">
		{eyebrow && <p class="eyebrow">{eyebrow}</p>}
		<h2 id={id}>
			{title} <em>{emphasis}</em>
		</h2>
		{description && <p>{description}</p>}
	</div>
)}

<style>
	.section-intro {
		max-width: 720px;
		margin: 0 auto clamp(3rem, 4.5vw, 4.5rem);
		text-align: center;
	}

	.eyebrow {
		margin: 0 0 0.65rem;
		color: var(--primary);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		line-height: 1.33;
		text-transform: uppercase;
	}

	h2 {
		margin: 0;
		color: var(--ink);
		font-family: var(--font-display);
		font-size: clamp(2.1rem, 3.8vw, 4.1rem);
		font-weight: 400;
		letter-spacing: -0.045em;
		line-height: 1;
	}

	h2 em {
		color: var(--blue-deep);
	}

	p {
		max-width: 540px;
		margin: 1rem auto 0;
		color: var(--muted);
		font-size: 0.86rem;
		line-height: 1.6;
	}

	.section-intro--split {
		max-width: 1320px;
		margin: 0 auto clamp(3rem, 5vw, 4.5rem);
		text-align: left;
	}

	.section-intro--split .eyebrow {
		max-width: none;
		display: flex;
		align-items: center;
		gap: 0.8rem;
		margin: 0 0 1.5rem;
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		line-height: inherit;
	}

	.section-intro--split .eyebrow span {
		width: 2rem;
		height: 1px;
		background: currentColor;
	}

	.split-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.65fr) minmax(260px, 0.75fr);
		align-items: end;
		gap: clamp(3rem, 7vw, 7rem);
	}

	.section-intro--split h2 {
		color: var(--foreground);
		font-size: clamp(2.5rem, 3.8vw, 3.65rem);
		font-weight: 500;
	}

	.section-intro--split h2 em {
		color: var(--primary);
	}

	.section-intro--split .split-description {
		max-width: 390px;
		margin: 0 0 0.25rem;
		font-size: clamp(0.9rem, 1.25vw, 1.08rem);
		line-height: 1.7;
	}

	@media (max-width: 1000px) {
		.section-intro--split h2 {
			font-size: clamp(2.15rem, 4.6vw, 2.85rem);
		}
	}

	@media (max-width: 560px) {
		.split-grid {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.section-intro--split h2 {
			font-size: clamp(1.65rem, 7.4vw, 2.2rem);
		}
	}
</style>
