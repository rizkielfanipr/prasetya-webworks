---
/**
 * A row of filters. As links (catalog: each filter is its own page) or as toggle buttons
 * handled by page script (home preview), where `aria-pressed` marks the active one.
 * `chips` are bordered pills; `tabs` are plain labels with an underline on the active one.
 */
interface Item {
	label: string;
	active: boolean;
	/** Link target (link mode). */
	href?: string;
	/** Extra data-* attributes for page script (button mode), e.g. { 'data-filter': 'all' }. */
	data?: Record<string, string>;
}

interface Props {
	items: Item[];
	mode: 'link' | 'button';
	/** Accessible name of the group. */
	label: string;
	id?: string;
	variant?: 'chips' | 'tabs';
}

const { items, mode, label, id, variant = 'chips' } = Astro.props;
const classes = ['filter-chips', `filter-chips--${variant}`];
---

{mode === 'link' ? (
	<nav class:list={classes} id={id} aria-label={label}>
		{items.map((item) => (
			<a class="filter-chip" href={item.href} aria-current={item.active ? 'page' : undefined}>
				{item.label}
			</a>
		))}
	</nav>
) : (
	<div class:list={classes} id={id} role="group" aria-label={label}>
		{items.map((item) => (
			<button class="filter-chip" type="button" aria-pressed={item.active ? 'true' : 'false'} {...item.data}>
				{item.label}
			</button>
		))}
	</div>
)}

<style>
	.filter-chips {
		max-width: 1320px;
		margin: 0 auto 2rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
	}

	.filter-chip {
		flex: none;
		padding: 0.6rem 0.95rem;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--ink);
		background: rgba(255, 255, 255, 0.78);
		border: 1px solid var(--line);
		border-radius: 12px;
		font: inherit;
		font-size: 0.68rem;
		letter-spacing: 0.03em;
		text-decoration: none;
		cursor: pointer;
		transition:
			background 0.2s,
			border-color 0.2s,
			color 0.2s;
	}

	.filter-chip:hover {
		border-color: var(--blue);
	}

	.filter-chip[aria-pressed='true'],
	.filter-chip[aria-current] {
		color: var(--primary-foreground);
		background: var(--blue);
		border-color: var(--blue);
	}

	.filter-chip:focus-visible {
		outline: 3px solid var(--blue-soft);
		outline-offset: 2px;
	}

	/* Tabs scroll sideways inside their own row instead of wrapping. */
	.filter-chips--tabs {
		margin-bottom: 1.75rem;
		justify-content: flex-start;
		flex-wrap: nowrap;
		gap: 1.75rem;
		overflow-x: auto;
		border-bottom: 1px solid var(--border);
		scrollbar-width: none;
	}

	.filter-chips--tabs .filter-chip {
		padding: 0.75rem 0 0.85rem;
		position: relative;
		color: var(--foreground);
		background: none;
		border: 0;
		border-radius: 0;
		font-size: 0.92rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		white-space: nowrap;
	}

	.filter-chips--tabs .filter-chip:hover {
		color: var(--primary);
	}

	.filter-chips--tabs .filter-chip[aria-pressed='true'],
	.filter-chips--tabs .filter-chip[aria-current] {
		color: var(--primary);
		background: none;
	}

	.filter-chips--tabs .filter-chip[aria-pressed='true']::after,
	.filter-chips--tabs .filter-chip[aria-current]::after {
		content: '';
		position: absolute;
		right: 0;
		bottom: -1px;
		left: 0;
		height: 2px;
		background: var(--primary);
		border-radius: 2px;
	}

	@media (max-width: 560px) {
		.filter-chips {
			gap: 0.4rem;
		}
		.filter-chip {
			padding: 0.5rem 0.8rem;
			font-size: 0.64rem;
		}
		.filter-chips--tabs {
			gap: 1.25rem;
		}
		.filter-chips--tabs .filter-chip {
			padding: 0.65rem 0 0.75rem;
			font-size: 0.85rem;
		}
	}
</style>
