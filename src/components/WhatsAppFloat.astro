---
interface Props {
	href: string;
	label: string;
}

const { href, label } = Astro.props;
---

<a class="whatsapp-float" href={href} aria-label={label} title={label}>
	<i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
</a>

<style>
	.whatsapp-float { width:58px; height:58px; position:fixed; z-index:40; right:clamp(1rem,2.5vw,2rem); bottom:clamp(1rem,2.5vw,2rem); display:grid; place-items:center; color:#fff; background:#25d366; border:1px solid rgba(255,255,255,.45); border-radius:50%; box-shadow:0 10px 28px rgba(16,80,43,.32); text-decoration:none; transition:background .2s ease,box-shadow .2s ease,transform .2s ease; }
	.whatsapp-float i { font-size:1.8rem; line-height:1; }
	.whatsapp-float:hover { color:#fff; background:#1ebe5d; box-shadow:0 14px 34px rgba(16,80,43,.4); transform:translateY(-3px) scale(1.04); }
	.whatsapp-float:focus-visible { outline:3px solid #fff; outline-offset:3px; box-shadow:0 0 0 6px rgba(37,211,102,.5); }
	@media (max-width:560px) { .whatsapp-float { width:54px; height:54px; right:1rem; bottom:1rem; }.whatsapp-float i { font-size:1.65rem; } }
	@media (prefers-reduced-motion:reduce) { .whatsapp-float { transition:none; } }
</style>
