---
import OrderFields from '../order/OrderFields.astro';
import OrderConsent from '../order/OrderConsent.astro';
import OrderChoiceDialog from '../order/OrderChoiceDialog.astro';
import { content, type Locale } from '../../i18n/content';
import { site } from '../../config/site';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { modal: t, orderForm: f, pricingIntro: p } = content[locale];
---

<dialog class="package-modal" id="package-modal" aria-labelledby="package-modal-title">
	<div class="package-modal-shell">
		<button class="modal-close" type="button" data-modal-close aria-label={t.close}>
			×
		</button>
		{/* Mirrors the popular pricing card in PricingSection so the choice reads as the same card. */}
		<section class="package-summary" aria-label={t.detail}>
			<p class="summary-badge">{t.selected}</p>
			<h2 id="package-modal-title" data-modal-package-name></h2>
			<p class="summary-tagline" data-modal-package-tagline></p>
			<p class="summary-price" data-modal-package-price></p>
			<p class="summary-title">{t.included}</p>
			<ul class="summary-features" data-modal-package-features></ul>
			<dl class="summary-meta">
				<div>
					<dt>{p.revisions}</dt>
					<dd data-modal-revisions></dd>
				</div>
				<div>
					<dt>{p.estimate}</dt>
					<dd data-modal-estimate></dd>
				</div>
			</dl>
			{/* Radios live here but belong to the order form through the form attribute. */}
			<fieldset class="domain-choice">
				<legend class="summary-title">{f.domainChoice}</legend>
				<div class="domain-options" data-modal-domains></div>
			</fieldset>
			<ul class="summary-notes">
				<li>{t.renewal}</li>
				<li>{t.revisions}</li>
				<li>{t.estimate}</li>
			</ul>
		</section>
		<form
			class="package-order-form"
			id="package-order-form"
			data-greeting={f.summary.greeting.replace('{site}', site.name)}
			data-package-label={f.summary.package}
			data-price-label={f.summary.price}
			data-name-label={f.summary.name}
			data-business-label={f.summary.business}
			data-domain-label={f.summary.domain}
			data-email-label={f.summary.email}
			data-whatsapp-label={f.summary.whatsapp}
			data-notes-label={f.summary.notes}
			data-sent-status={f.sent}
		>
			<h2>{t.title}</h2>
			<p>{t.description}</p>
			<OrderFields locale={locale} />
			<OrderConsent locale={locale} />
			<button class="order-submit" type="submit">
				{site.platformApiUrl ? f.continue : f.submit} <span aria-hidden="true">↗</span>
			</button>
			<p class="order-status" role="status" aria-live="polite"></p>
		</form>
	</div>
</dialog>
<OrderChoiceDialog locale={locale} />

<script>
	import { openWhatsApp } from '../../scripts/whatsapp';
	import { domainName, orderMessage } from '../../scripts/order';
	import { hasOrderChoice, openOrderChoice } from '../../scripts/order-choice';

	interface SelectedPackage {
		name: string;
		code: string;
		price: string;
		tagline: string;
		features: string[];
		domains: string[];
		revisions: string;
		estimate: string;
	}

	const modal = document.querySelector<HTMLDialogElement>('#package-modal');
	const form = document.querySelector<HTMLFormElement>('#package-order-form');
	const name = modal?.querySelector<HTMLElement>('[data-modal-package-name]');
	const price = modal?.querySelector<HTMLElement>('[data-modal-package-price]');
	const tagline = modal?.querySelector<HTMLElement>('[data-modal-package-tagline]');
	const features = modal?.querySelector<HTMLUListElement>('[data-modal-package-features]');
	const domains = modal?.querySelector<HTMLElement>('[data-modal-domains]');
	const revisions = modal?.querySelector<HTMLElement>('[data-modal-revisions]');
	const estimate = modal?.querySelector<HTMLElement>('[data-modal-estimate]');
	const suffix = modal?.querySelector<HTMLElement>('[data-domain-suffix]');
	let selected: SelectedPackage | undefined;

	function domainOption(extension: string, checked: boolean) {
		const label = document.createElement('label');
		const radio = document.createElement('input');
		Object.assign(radio, { type: 'radio', name: 'extension', value: extension, checked, required: true });
		radio.setAttribute('form', 'package-order-form');
		radio.addEventListener('change', () => {
			if (suffix) suffix.textContent = extension;
		});
		label.append(radio, extension);
		return label;
	}

	// "Choose package" buttons in PricingSection carry the package details as JSON in data-package.
	document.querySelectorAll<HTMLButtonElement>('[data-package-select]').forEach((button) =>
		button.addEventListener('click', () => {
			selected = JSON.parse(button.dataset.package ?? '{}') as SelectedPackage;
			if (name) name.textContent = selected.name;
			if (price) price.textContent = selected.price;
			if (tagline) tagline.textContent = selected.tagline;
			if (revisions) revisions.textContent = selected.revisions;
			if (estimate) estimate.textContent = selected.estimate;
			if (suffix) suffix.textContent = selected.domains[0] ?? '';
			domains?.replaceChildren(...selected.domains.map((extension, index) => domainOption(extension, index === 0)));
			features?.replaceChildren(
				...selected.features.map((feature) => {
					const item = document.createElement('li');
					const check = document.createElement('span');
					check.setAttribute('aria-hidden', 'true');
					check.textContent = '✓';
					item.append(check, feature);
					return item;
				}),
			);
			modal?.showModal();
		}),
	);

	modal?.querySelector('[data-modal-close]')?.addEventListener('click', () => modal.close());
	modal?.addEventListener('click', (event) => {
		if (event.target === modal) modal.close();
	});

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (!selected) return;
		const data = new FormData(form);
		const label = form.dataset;
		const domain = `${domainName(String(data.get('domain')))}${data.get('extension') ?? ''}`;
		const message = orderMessage(label.greeting ?? '', [
			[label.packageLabel ?? '', selected.name],
			[label.priceLabel ?? '', selected.price],
			[label.nameLabel ?? '', String(data.get('name'))],
			[label.businessLabel ?? '', String(data.get('business'))],
			[label.domainLabel ?? '', domain],
			[label.emailLabel ?? '', String(data.get('email'))],
			[label.whatsappLabel ?? '', String(data.get('whatsapp'))],
			[label.notesLabel ?? '', String(data.get('notes'))],
		]);
		const sent = () => {
			const status = form.querySelector<HTMLElement>('.order-status');
			if (status) status.textContent = label.sentStatus ?? '';
		};
		if (!hasOrderChoice()) {
			openWhatsApp(message);
			sent();
			return;
		}
		openOrderChoice({
			order: {
				packageCode: selected.code,
				name: String(data.get('name')),
				email: String(data.get('email')),
				whatsapp: String(data.get('whatsapp')),
				business: String(data.get('business')),
				domain,
				notes: String(data.get('notes') ?? ''),
				templateCode: '',
			},
			whatsappMessage: message,
			onConsult: sent,
		});
	});
</script>

<style>
	.package-modal {
		width: min(1080px, calc(100% - 2rem));
		max-height: calc(100dvh - 2rem);
		padding: 0;
		overflow: auto;
		color: var(--ink);
		background: transparent;
		border: 0;
		border-radius: var(--radius);
		box-shadow: 0 32px 90px rgba(90, 35, 10, 0.24);
	}

	.package-modal::backdrop {
		background: rgba(15, 23, 42, 0.62);
		backdrop-filter: blur(9px);
	}

	.package-modal-shell {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
		overflow: hidden;
		background: var(--card);
		border: 1px solid var(--primary);
		border-radius: var(--radius);
		box-shadow: 0 0 0 1px var(--primary);
	}

	.modal-close {
		position: absolute;
		z-index: 5;
		top: 1rem;
		right: 1rem;
		width: 38px;
		height: 38px;
		display: grid;
		place-items: center;
		color: var(--foreground);
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 50%;
		cursor: pointer;
		font-size: 1.25rem;
		line-height: 1;
	}

	.modal-close:hover {
		border-color: var(--primary);
	}

	.modal-close:focus-visible {
		outline: 2px solid var(--blue);
		outline-offset: 2px;
	}

	/* Same surface, type scale and list style as `.pricing-card.popular`. */
	.package-summary {
		padding: clamp(1.6rem, 3vw, 2.4rem);
		display: flex;
		flex-direction: column;
		color: var(--ink);
		background: linear-gradient(180deg, var(--secondary) 0%, var(--card) 55%);
		border-right: 1px solid var(--border);
	}

	.summary-badge {
		align-self: flex-start;
		margin: 0 0 1rem;
		padding: 0.3rem 0.75rem;
		color: var(--primary-foreground);
		background: var(--primary);
		border-radius: 8px;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1.33;
		text-transform: uppercase;
	}

	.package-summary h2,
	.package-order-form h2 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.25;
	}

	.package-summary h2 {
		font-size: clamp(1.5rem, 2.2vw, 1.75rem);
	}

	.summary-tagline {
		margin: 0.5rem 0 0;
		color: var(--muted);
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.summary-price {
		margin: 1.25rem 0 0;
		padding-bottom: 1.25rem;
		color: var(--foreground);
		border-bottom: 1px solid var(--border);
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 2.6vw, 2.2rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}

	.summary-title {
		margin: 1.25rem 0 0.75rem;
		padding: 0;
		color: var(--muted);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.summary-features {
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.75rem;
		list-style: none;
		font-size: 0.875rem;
		line-height: 1.45;
	}

	/* Feature items are created by the script below, so they need :global to get styles. */
	.summary-features :global(li) {
		display: flex;
		gap: 0.65rem;
	}

	.summary-features :global(li span) {
		color: var(--primary);
		font-weight: 700;
	}

	.summary-meta {
		margin: 1.25rem 0 0;
		padding: 0.85rem 1rem;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		background: var(--background);
		border-radius: 12px;
	}

	.summary-meta dt {
		color: var(--muted);
		font-size: 0.75rem;
		font-weight: 600;
	}

	.summary-meta dd {
		margin: 0.15rem 0 0;
		color: var(--foreground);
		font-size: 0.9rem;
		font-weight: 700;
	}

	.domain-choice {
		margin: 1.25rem 0 0;
		padding: 0;
		border: 0;
	}

	/* A legend ignores its top margin inside the fieldset, so the fieldset carries the gap. */
	.domain-choice legend {
		margin-top: 0;
	}

	.domain-options {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.domain-options :global(label) {
		min-height: 42px;
		padding: 0.5rem 1rem;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--foreground);
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 12px;
		cursor: pointer;
		font-size: 0.875rem;
		font-weight: 600;
		transition: border-color 0.2s ease;
	}

	.domain-options :global(label:hover) {
		border-color: rgba(255, 81, 0, 0.45);
	}

	.domain-options :global(label:has(input:checked)) {
		background: var(--secondary);
		border-color: var(--primary);
		box-shadow: 0 0 0 1px var(--primary);
	}

	.domain-options :global(input) {
		margin: 0;
		accent-color: var(--primary);
	}

	.summary-notes {
		margin: auto 0 0;
		padding: 1.5rem 0 0 1rem;
		display: grid;
		gap: 0.4rem;
		color: var(--muted);
		font-size: 0.75rem;
		line-height: 1.6;
	}

	.package-order-form {
		padding: clamp(1.6rem, 3vw, 2.4rem);
		display: flex;
		flex-direction: column;
		background: var(--card);
	}

	.package-order-form h2 {
		padding-right: 2.5rem;
		font-size: clamp(1.5rem, 2.2vw, 1.75rem);
	}

	.package-order-form > p:not(.order-status) {
		margin: 0.5rem 0 1.25rem;
		padding-bottom: 1.25rem;
		color: var(--muted);
		border-bottom: 1px solid var(--border);
		font-size: 0.875rem;
		line-height: 1.6;
	}

	/* Same colours as the popular card's button, sized up as the form's main action. */
	.order-submit {
		width: 100%;
		min-height: 50px;
		margin-top: 0.25rem;
		padding: 0.85rem 1.1rem;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		color: var(--primary-foreground);
		background: var(--primary);
		border: 1px solid var(--primary);
		border-radius: 12px;
		box-shadow: var(--brand-shadow);
		cursor: pointer;
		font-size: 0.95rem;
		font-weight: 600;
		transition: background 0.2s ease;
	}

	.order-submit:hover {
		background: var(--blue-hover);
	}

	.order-submit:focus-visible {
		outline: 2px solid var(--blue);
		outline-offset: 3px;
	}

	.order-submit span {
		transition: transform 0.25s ease;
	}

	.order-submit:hover span {
		transform: translate3d(3px, -2px, 0);
	}

	.order-status {
		min-height: 1rem;
		margin: 0.75rem 0 0;
		color: var(--muted);
		font-size: 0.8rem;
	}

	@media (max-width: 1000px) {
		.package-modal-shell {
			grid-template-columns: minmax(0, 1fr);
		}

		.package-summary {
			border-right: 0;
			border-bottom: 1px solid var(--border);
		}
	}

	@media (max-width: 560px) {
		.package-modal {
			width: calc(100% - 1rem);
			max-height: calc(100dvh - 1rem);
		}

		.package-summary,
		.package-order-form {
			padding: 1.4rem 1.25rem;
		}

		.modal-close {
			top: 0.7rem;
			right: 0.7rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.order-submit,
		.order-submit span,
		.domain-options :global(label) {
			animation: none !important;
			transition: none !important;
		}
	}
</style>
