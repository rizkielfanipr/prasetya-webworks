---
import { content, type Locale } from '../../i18n/content';

interface Props {
	locale: Locale;
}

const t = content[Astro.props.locale].partners;
// Placeholder marks until real client logos are available.
const partners = Array.from({ length: 6 }, (_, index) => {
	const number = String(index + 1).padStart(2, '0');
	return { name: `${t.name} ${number}`, mark: `M${number}`, shape: `partner-mark-${(index % 3) + 1}` };
});
---

<section class="partner-strip" aria-labelledby="partner-title">
	<div class="partner-heading">
		<h2 id="partner-title">
			{t.title} <em>{t.emphasis}</em>
		</h2>
		<p>{t.description}</p>
	</div>
	<div class="partner-marquee" tabindex="0" aria-label={t.aria}>
		<div class="partner-track">
			{/* The list is rendered twice so the marquee can loop seamlessly; the copy is hidden from assistive tech. */}
			{[false, true].map((copy) => (
				<div class="partner-group" aria-hidden={copy ? 'true' : undefined}>
					{partners.map((partner) => (
						<div class="partner-item">
							<span class:list={['partner-mark', partner.shape]} aria-hidden={copy ? undefined : 'true'}>
								{partner.mark}
							</span>
							<strong>{partner.name}</strong>
						</div>
					))}
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.partner-strip {
		position: relative;
		padding: clamp(2.6rem, 4vw, 3.8rem) 0 clamp(3.4rem, 5vw, 5rem);
		overflow: hidden;
		/* Color stops continue into the benefits section below. */
		background:
			radial-gradient(circle at 0 118%, rgba(174, 191, 243, 0.32), transparent 34%),
			linear-gradient(180deg, #fffdf8 0%, #f8f6f0 60%, #f1f2f8 100%);
	}

	.partner-heading {
		max-width: 860px;
		margin: 0 auto;
		padding: 0 clamp(1.25rem, 5vw, 5rem);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.7rem;
		text-align: center;
	}

	.partner-heading h2 {
		margin: 0;
		color: var(--ink);
		font-family: var(--font-serif);
		font-size: clamp(1.85rem, 2.8vw, 2.9rem);
		font-weight: 400;
		letter-spacing: -0.04em;
		line-height: 1;
	}

	.partner-heading h2 em {
		color: var(--blue);
		font-weight: 400;
	}

	.partner-heading p {
		max-width: 420px;
		margin: 0;
		color: var(--muted);
		font-size: 0.62rem;
		line-height: 1.5;
		text-align: center;
	}

	.partner-marquee {
		width: 100%;
		margin-top: 2.15rem;
		position: relative;
		overflow: hidden;
		outline: none;
		background: transparent;
		-webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 12%, #000 88%, transparent 100%);
		mask-image: linear-gradient(90deg, transparent 0%, #000 12%, #000 88%, transparent 100%);
	}

	.partner-track {
		width: max-content;
		display: flex;
		transform: translate3d(0, 0, 0);
		animation: partner-marquee 48s linear infinite;
		will-change: transform;
		backface-visibility: hidden;
	}

	.partner-marquee:focus-visible .partner-track {
		animation-play-state: paused;
	}

	.partner-group {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		gap: 1.25rem;
		padding-right: 1.25rem;
	}

	.partner-item {
		width: clamp(170px, 15vw, 220px);
		min-height: 72px;
		padding: 0.75rem 1rem;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.82rem;
		color: #7a7d86;
		background: transparent;
		border: 1px solid transparent;
		border-radius: 18px;
		filter: grayscale(1);
		opacity: 0.72;
		transition:
			color 0.25s,
			border-color 0.25s,
			background 0.25s,
			filter 0.25s,
			opacity 0.25s;
	}

	.partner-item:hover {
		color: var(--blue-deep);
		filter: grayscale(0);
		opacity: 1;
	}

	.partner-mark {
		width: 44px;
		height: 44px;
		display: grid;
		place-items: center;
		flex: 0 0 44px;
		color: #fff;
		background: linear-gradient(145deg, #757985, #3d414d);
		border-radius: 14px 14px 14px 5px;
		font-size: 0.54rem;
		font-weight: 800;
		letter-spacing: 0.04em;
	}

	.partner-mark-2 {
		border-radius: 50%;
		background: linear-gradient(145deg, #9498a2, #50545e);
	}

	.partner-mark-3 {
		clip-path: polygon(50% 0, 100% 28%, 86% 100%, 14% 100%, 0 28%);
		border-radius: 0;
		background: linear-gradient(145deg, #858995, #444853);
	}

	.partner-item:hover .partner-mark {
		background: linear-gradient(145deg, var(--blue), var(--blue-deep));
	}

	.partner-item strong {
		font-family: var(--font-serif);
		font-size: 0.92rem;
		font-weight: 400;
		letter-spacing: 0.01em;
	}

	@keyframes partner-marquee {
		from {
			transform: translate3d(0, 0, 0);
		}
		to {
			transform: translate3d(-50%, 0, 0);
		}
	}

	@media (max-width: 560px) {
		.partner-strip {
			padding-block: 2.4rem 3.5rem;
		}
		.partner-heading h2 {
			font-size: 2rem;
		}
		.partner-marquee {
			margin-top: 1.5rem;
		}
		.partner-item {
			width: 190px;
			min-height: 74px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.partner-track {
			width: auto;
			animation: none;
		}
		.partner-marquee {
			overflow-x: auto;
			scrollbar-width: none;
		}
		.partner-marquee::-webkit-scrollbar {
			display: none;
		}
		.partner-group[aria-hidden='true'] {
			display: none;
		}
	}
</style>
