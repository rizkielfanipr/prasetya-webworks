---
import SectionIntro from '../ui/SectionIntro.astro';
import { content, type Locale } from '../../i18n/content';

interface Props {
	locale: Locale;
}

const t = content[Astro.props.locale];
---

<section class="faq section-pad" id="faq" aria-labelledby="faq-title">
	<SectionIntro id="faq-title" title={t.faqTitle.title} emphasis={t.faqTitle.emphasis} />
	<div class="faq-list">
		{t.faqs.map((faq) => (
			<details>
				<summary>
					{faq.question}
					<span aria-hidden="true">+</span>
				</summary>
				<p>{faq.answer}</p>
			</details>
		))}
	</div>
</section>

<style>
	.faq {
		background:
			radial-gradient(circle at 82% 38%, rgba(174, 191, 243, 0.34), transparent 26%),
			linear-gradient(180deg, #e9edff 0%, #e9edff 68%, #f0f0f0 90%, var(--ivory) 100%);
	}

	.faq-list {
		max-width: 1080px;
		margin: auto;
		display: grid;
		gap: 0.75rem;
	}

	.faq-list details {
		overflow: hidden;
		background: rgba(255, 255, 255, 0.48);
		border: 1px solid rgba(23, 58, 155, 0.2);
		border-radius: 16px;
		transition:
			background 0.2s,
			box-shadow 0.2s;
	}

	.faq-list details[open] {
		background: rgba(255, 255, 255, 0.78);
		box-shadow: 0 12px 25px rgba(23, 58, 155, 0.08);
	}

	.faq-list summary {
		min-height: 64px;
		padding: 0 1rem;
		display: flex;
		justify-content: space-between;
		gap: 2rem;
		align-items: center;
		cursor: pointer;
		list-style: none;
		color: var(--ink);
		font-family: var(--font-serif);
		font-size: 0.94rem;
	}

	.faq-list summary::-webkit-details-marker {
		display: none;
	}

	/* The "+" badge turns into "×" when the item is open. */
	.faq-list summary span {
		width: 27px;
		height: 27px;
		flex: 0 0 27px;
		display: grid;
		place-items: center;
		color: #fff;
		background: var(--blue);
		border-radius: 50%;
		font-family: Arial, sans-serif;
		font-size: 1rem;
		transition:
			transform 0.28s cubic-bezier(0.2, 0.72, 0.2, 1),
			background 0.2s ease;
	}

	.faq-list details[open] summary span {
		transform: rotate(45deg);
		background: var(--blue-deep);
	}

	.faq-list details p {
		max-width: 740px;
		margin: 0 3rem 1.35rem 1rem;
		color: var(--muted);
		font-size: 0.79rem;
		line-height: 1.65;
	}

	@media (max-width: 560px) {
		.faq-list summary {
			font-size: 0.95rem;
		}
	}
</style>
