---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../layout/SiteHeader.astro';
import SiteFooter from '../layout/SiteFooter.astro';
import HeroSection from './HeroSection.astro';
import PartnersSection from './PartnersSection.astro';
import BenefitsSection from './BenefitsSection.astro';
import PricingSection from './PricingSection.astro';
import TemplatesSection from './TemplatesSection.astro';
import FaqSection from './FaqSection.astro';
import ContactSection from './ContactSection.astro';
import PackageModal from './PackageModal.astro';
import { content, type Locale } from '../../i18n/content';
import { homePath } from '../../data/templates';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];

// Hidden until real client logos are available; flip to true to show the section and its "Mitra" nav links.
const showPartners = false;
---

<Layout lang={locale} title={t.meta.title} description={t.meta.description} alternates={{ id: homePath('id'), en: homePath('en') }}>
	<SiteHeader locale={locale} alternates={{ id: homePath('id'), en: homePath('en') }} onHome showPartners={showPartners} />

	<main id="top">
		<HeroSection locale={locale} />

		<div class="content-shell" id="partners">
			{showPartners && <PartnersSection locale={locale} />}
			<BenefitsSection locale={locale} />
			<PricingSection locale={locale} />
			<TemplatesSection locale={locale} />
			<FaqSection locale={locale} />
			<ContactSection locale={locale} />
		</div>

		<PackageModal locale={locale} />
	</main>

	<SiteFooter locale={locale} showAbout={showPartners} />
</Layout>

<script>
	import { initScrollReveal } from '../../scripts/scroll-reveal';

	initScrollReveal([
		'.partner-heading',
		'.section-intro',
		'.benefit-card',
		'.pricing-card',
		'.template-card',
		'.faq-list details',
		'.contact-form',
		'.testimonial-heading',
		'.testimonial-marquees',
	]);
</script>

<style>
	/* Rounded sheet that slides up over the bottom of the hero. */
	.content-shell {
		position: relative;
		z-index: 4;
		margin-top: -54px;
		overflow: hidden;
		/* Makes Safari clip composited children to the rounded corners. */
		isolation: isolate;
		border-radius: 32px 32px 0 0;
		background: var(--ivory);
	}

	@media (max-width: 800px) {
		.content-shell {
			margin-top: -30px;
			border-radius: 22px 22px 0 0;
		}
	}
</style>
