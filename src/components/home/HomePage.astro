---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../layout/SiteHeader.astro';
import SiteFooter from '../layout/SiteFooter.astro';
import HeroSection from './HeroSection.astro';
import PartnersSection from './PartnersSection.astro';
import PricingSection from './PricingSection.astro';
import TemplatesSection from './TemplatesSection.astro';
import WorkProcessSection from './WorkProcessSection.astro';
import TestimonialsPanel from './TestimonialsPanel.astro';
import FaqSection from './FaqSection.astro';
import ContactSection from './ContactSection.astro';
import PackageModal from './PackageModal.astro';
import { content, type Locale } from '../../i18n/content';
import { homePath } from '../../data/templates';
import { site } from '../../config/site';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];

// Hidden until real client logos are available; flip to true to show the section and its "Mitra" nav links.
const showPartners = false;
// Hidden until there are real client reviews; the current entries are placeholders.
const showTestimonials = false;

// schema.org data so search engines know the business name, what it offers and at what price.
const url = new URL(homePath(locale), Astro.site).href;
const structuredData = [
	{ '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url, inLanguage: locale },
	{
		'@context': 'https://schema.org',
		'@type': 'ProfessionalService',
		name: site.name,
		url,
		description: t.meta.description,
		logo: new URL(site.logoSquare, Astro.site).href,
		image: new URL(site.ogImage, Astro.site).href,
		email: site.email,
		telephone: `+${site.whatsapp}`,
		areaServed: { '@type': 'Country', name: 'Indonesia' },
		address: { '@type': 'PostalAddress', addressCountry: 'ID' },
		makesOffer: t.packages.map((item) => ({
			'@type': 'Offer',
			name: item.name,
			description: item.tagline,
			price: item.price.replace(/\D/g, ''),
			priceCurrency: 'IDR',
		})),
	},
];
---

<Layout
	lang={locale}
	title={t.meta.title}
	description={t.meta.description}
	alternates={{ id: homePath('id'), en: homePath('en') }}
	structuredData={structuredData}
>
	<SiteHeader locale={locale} alternates={{ id: homePath('id'), en: homePath('en') }} onHome showPartners={showPartners} />

	<main id="top">
		<HeroSection locale={locale} />

		<div class="content-shell" id="partners">
			{showPartners && <PartnersSection locale={locale} />}
			<TemplatesSection locale={locale} />
			<WorkProcessSection locale={locale} />
			{showTestimonials && <TestimonialsPanel locale={locale} />}
			<PricingSection locale={locale} />
			<FaqSection locale={locale} />
			<ContactSection locale={locale} />
		</div>

		<PackageModal locale={locale} />
	</main>

	<SiteFooter locale={locale} showPartners={showPartners} />
</Layout>

<script>
	import { initScrollReveal } from '../../scripts/scroll-reveal';

	initScrollReveal([
		'.partner-heading',
		'.section-intro',
		'.pricing-card',
		'.template-card',
		'.process-timeline li',
		'.faq-list details',
		'.cta-banner',
		'.testimonial-heading',
		'.testimonial-marquees',
	]);
</script>

<style>
	/* Warm shadcn-style content sheet over the hero. */
	.content-shell {
		position: relative;
		z-index: 4;
		margin-top: -54px;
		overflow: hidden;
		/* Makes Safari clip composited children to the rounded corners. */
		isolation: isolate;
		border: 1px solid rgba(255, 81, 0, 0.14);
		border-bottom: 0;
		border-radius: 24px 24px 0 0;
		background: var(--ivory);
	}

	@media (max-width: 800px) {
		.content-shell {
			margin-top: -30px;
			border-radius: 18px 18px 0 0;
		}
	}
</style>
