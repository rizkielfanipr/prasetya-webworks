---
import SectionIntro from '../ui/SectionIntro.astro';
import { content, type Locale } from '../../i18n/content';

interface Props {
	locale: Locale;
}

const t = content[Astro.props.locale];
---

<section class="benefits section-pad" id="why-us" aria-labelledby="benefit-title">
	<SectionIntro id="benefit-title" title={t.benefitsIntro.title} emphasis={t.benefitsIntro.emphasis} eyebrow={t.benefitsIntro.eyebrow} />
	<div class="benefit-grid">
		{t.benefits.map((benefit) => (
			<article class="benefit-card">
				<div class="benefit-icon" aria-hidden="true">
					{benefit.icon === 'tag' && (
						<svg viewBox="0 0 24 24">
							<path d="M20 13 13 20l-9-9V4h7l9 9Z" />
							<path d="M8.5 8.5h.01" />
						</svg>
					)}
					{benefit.icon === 'clock' && (
						<svg viewBox="0 0 24 24">
							<circle cx="12" cy="12" r="9" />
							<path d="M12 7v5l3 2" />
						</svg>
					)}
					{benefit.icon === 'desktop' && (
						<svg viewBox="0 0 24 24">
							<rect x="3" y="4" width="18" height="13" rx="1" />
							<path d="M8 21h8M12 17v4" />
						</svg>
					)}
					{benefit.icon === 'settings' && (
						<svg viewBox="0 0 24 24">
							<circle cx="12" cy="12" r="3" />
							<path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21h-4v-.1A1.7 1.7 0 0 0 8.6 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3v-4h.1A1.7 1.7 0 0 0 4.6 8.6a1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3h4v.1A1.7 1.7 0 0 0 15.4 4.6a1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06A1.7 1.7 0 0 0 19.4 9c.15.37.37.7.6 1 .3.35.7.55 1.1.6h.1v4h-.1a1.7 1.7 0 0 0-1.7.4Z" />
						</svg>
					)}
				</div>
				<div class="benefit-copy">
					<h3>{benefit.title}</h3>
					<p>{benefit.text}</p>
				</div>
			</article>
		))}
	</div>
</section>

<style>
	.benefits {
		position: relative;
		background:
			radial-gradient(circle at 0 4%, rgba(255, 145, 88, 0.2), transparent 30%),
			linear-gradient(180deg, #fffaf4 0%, #fff6ee 50%, #fff1e8 100%);
	}

	/* Soft glows. Radial gradients instead of filter: blur(), which Safari iOS clips to a square inside the rounded content shell. */
	.benefits::before {
		content: '';
		position: absolute;
		width: 460px;
		height: 460px;
		top: calc(8% - 20px);
		left: -270px;
		background: radial-gradient(circle closest-side, var(--blue-soft) 83%, transparent);
		opacity: 0.58;
		pointer-events: none;
	}

	.benefits::after {
		content: '';
		position: absolute;
		right: -214px;
		bottom: calc(2% - 34px);
		width: 488px;
		height: 488px;
		background: radial-gradient(circle closest-side, rgba(255, 253, 248, 0.85) 72%, transparent);
		pointer-events: none;
	}

	.benefit-grid {
		position: relative;
		z-index: 1;
		max-width: 1320px;
		margin: auto;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.15rem;
	}

	.benefit-card {
		min-height: 255px;
		padding: 2rem;
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		background: rgba(255, 255, 255, 0.68);
		border: 1px solid rgba(255, 81, 0, 0.3);
		border-radius: var(--radius);
		box-shadow: none;
		transition:
			border-color 180ms ease,
			transform 180ms ease,
			background-color 180ms ease;
	}

	.benefit-card:hover {
		background: rgba(255, 255, 255, 0.9);
		border-color: rgba(255, 81, 0, 0.6);
		transform: translateY(-3px);
	}

	.benefit-icon {
		width: 48px;
		height: 48px;
		display: grid;
		place-items: center;
		color: var(--primary);
		background: var(--secondary);
		border-radius: 14px;
	}

	.benefit-icon svg {
		width: 30px;
		height: 30px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}

	.benefit-copy {
		margin-top: 2.4rem;
	}

	.benefit-card h3 {
		margin: 0 0 0.7rem;
		color: var(--ink);
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(1.05rem, 1.4vw, 1.28rem);
		letter-spacing: -0.025em;
	}

	.benefit-card p {
		margin: 0;
		color: var(--muted);
		font-size: 0.875rem;
		line-height: 1.65;
	}

	@media (max-width: 1000px) {
		.benefit-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 800px) {
		.benefit-card {
			min-height: 230px;
		}
	}

	@media (max-width: 560px) {
		.benefit-grid {
			grid-template-columns: 1fr;
		}
		.benefit-card {
			min-height: 0;
			padding: 1.5rem;
		}
		.benefit-copy {
			margin-top: 2rem;
		}
		.benefit-card h3 {
			font-size: 1.3rem;
		}
	}
</style>
