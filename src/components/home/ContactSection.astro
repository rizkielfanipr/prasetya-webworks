---
import { content, type Locale } from '../../i18n/content';
import { site } from '../../config/site';
import { whatsappUrl } from '../../scripts/whatsapp';

interface Props {
	locale: Locale;
}

const { contact: t, packages } = content[Astro.props.locale];
// "From {price}" follows the cheapest package so the banner never disagrees with the pricing cards.
const highlights = t.highlights.map((item) => item.replace('{price}', packages[0].price));
---

<section class="contact section-pad" id="contact" aria-labelledby="contact-title">
	<div class="contact-banner">
		<p class="contact-eyebrow">{t.eyebrow}</p>
		<h2 id="contact-title">
			{t.title}
			<br />
			<em>{t.emphasis}</em>.
		</h2>
		<p class="contact-description">{t.description}</p>
		<div class="contact-actions">
			<a class="contact-primary" href="#packages">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="9"></circle>
					<path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"></path>
				</svg>
				{t.primary}
				<span class="contact-arrow" aria-hidden="true">
					→
				</span>
			</a>
			<a class="contact-secondary" href={whatsappUrl(t.message.replace('{site}', site.name))} target="_blank" rel="noopener">
				<i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
				{t.secondary}
			</a>
		</div>
		<p class="contact-highlights">{highlights.join(' · ')}</p>
	</div>
</section>

<style>
	.contact {
		background: var(--card);
	}

	.contact-banner {
		max-width: 1320px;
		margin: auto;
		padding: clamp(3.5rem, 7vw, 6.5rem) clamp(1.5rem, 5vw, 4rem);
		position: relative;
		overflow: hidden;
		isolation: isolate;
		color: var(--primary-foreground);
		text-align: center;
		background:
			radial-gradient(circle at 8% 100%, rgba(255, 81, 0, 0.32), transparent 38%),
			linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px) 0 0 / 64px 64px,
			linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px) 0 0 / 64px 64px,
			var(--foreground);
		border-radius: 24px;
	}

	.contact-eyebrow {
		margin: 0 0 1.6rem;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		color: var(--primary);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.contact-eyebrow::before,
	.contact-eyebrow::after {
		content: '';
		width: 2.5rem;
		height: 1px;
		background: currentColor;
	}

	.contact-banner h2 {
		margin: 0 auto;
		font-family: var(--font-display);
		font-size: clamp(2.3rem, 5vw, 4.4rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1.08;
	}

	/* The emphasis sits on its own line over a highlighter stroke. */
	.contact-banner h2 em {
		padding-inline: 0.12em;
		font-style: italic;
		font-weight: 500;
		background: linear-gradient(transparent 58%, rgba(255, 81, 0, 0.6) 58%, rgba(255, 81, 0, 0.6) 88%, transparent 88%);
		box-decoration-break: clone;
	}

	.contact-description {
		max-width: 620px;
		margin: 1.6rem auto 0;
		color: rgba(255, 255, 255, 0.78);
		font-size: clamp(0.95rem, 1.4vw, 1.12rem);
		line-height: 1.7;
	}

	.contact-actions {
		margin-top: 2.4rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
	}

	.contact-primary,
	.contact-secondary {
		min-height: 56px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		border-radius: var(--radius);
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			transform 180ms ease,
			background-color 180ms ease,
			border-color 180ms ease;
	}

	.contact-primary {
		padding: 0.5rem 0.6rem 0.5rem 1.4rem;
		color: var(--primary-foreground);
		background: var(--primary);
		box-shadow: var(--brand-shadow);
	}

	.contact-primary:hover {
		background: var(--blue-hover);
		transform: translateY(-2px);
	}

	.contact-primary svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
	}

	.contact-arrow {
		width: 38px;
		height: 38px;
		display: grid;
		place-items: center;
		color: var(--primary);
		background: var(--primary-foreground);
		border-radius: 12px;
		transition: transform 180ms ease;
	}

	.contact-primary:hover .contact-arrow {
		transform: translateX(3px);
	}

	.contact-secondary {
		padding: 0.5rem 1.5rem;
		color: var(--primary-foreground);
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.28);
	}

	.contact-secondary:hover {
		background: rgba(255, 255, 255, 0.1);
		border-color: rgba(255, 255, 255, 0.5);
		transform: translateY(-2px);
	}

	.contact-secondary i {
		color: #25d366;
		font-size: 1.25rem;
	}

	.contact-primary:focus-visible,
	.contact-secondary:focus-visible {
		outline: 2px solid var(--primary-foreground);
		outline-offset: 3px;
	}

	.contact-highlights {
		margin: 2.6rem 0 0;
		color: rgba(255, 255, 255, 0.5);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	@media (max-width: 560px) {
		.contact {
			padding-inline: 1rem;
		}

		.contact-banner {
			border-radius: var(--radius);
		}

		.contact-actions {
			flex-direction: column;
			align-items: stretch;
		}

		.contact-primary {
			justify-content: space-between;
		}

		.contact-primary svg {
			display: none;
		}

		.contact-highlights {
			letter-spacing: 0.12em;
			line-height: 1.8;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-primary,
		.contact-secondary,
		.contact-arrow {
			transition: none;
		}
	}
</style>
