---
import CtaBanner from '../ui/CtaBanner.astro';
import { content, type Locale } from '../../i18n/content';
import { site } from '../../config/site';

interface Props {
	locale: Locale;
}

const { contact: t, packages } = content[Astro.props.locale];
// "From {price}" follows the cheapest package so the banner never disagrees with the pricing cards.
const highlights = t.highlights.map((item) => item.replace('{price}', packages[0].price));
---

<section class="contact section-pad" id="contact" aria-labelledby="contact-title">
	<CtaBanner
		id="contact-title"
		eyebrow={t.eyebrow}
		title={t.title}
		emphasis={t.emphasis}
		titleEnd="."
		description={t.description}
		primary={{ label: t.primary, href: '#packages' }}
		whatsapp={{ label: t.secondary, message: t.message.replace('{site}', site.name) }}
		highlights={highlights}
	/>
</section>

<style>
	.contact {
		background: var(--card);
	}

	@media (max-width: 560px) {
		.contact {
			padding-inline: 1rem;
		}
	}
</style>
