---
/**
 * Customer fields of an order: name, WhatsApp, email, business, preferred domain and notes.
 * The domain extension is chosen elsewhere (radios named "extension"); the parent's script
 * writes it into [data-domain-suffix], and the domain is checked whenever either part changes.
 */
import { content, type Locale } from '../../i18n/content';

interface Props {
	locale: Locale;
}

const t = content[Astro.props.locale].orderForm;
---

<div class="order-fields">
	<div class="field-row">
		<label>
			{t.name}
			<input name="name" type="text" autocomplete="name" placeholder={t.namePlaceholder} required />
		</label>
		<label>
			{t.whatsapp}
			<input name="whatsapp" type="tel" autocomplete="tel" placeholder="08xxxxxxxxxx" required />
		</label>
	</div>
	<label>
		{t.email}
		<input name="email" type="email" autocomplete="email" placeholder="nama@email.com" required />
	</label>
	<label>
		{t.business}
		<input name="business" type="text" autocomplete="organization" placeholder={t.businessPlaceholder} required />
	</label>
	<label>
		{t.domain}
		<span class="domain-input">
			<input
				name="domain"
				type="text"
				inputmode="url"
				autocapitalize="none"
				spellcheck="false"
				placeholder={t.domainPlaceholder}
				required
			/>
			<span aria-hidden="true" data-domain-suffix></span>
		</span>
	</label>
	{/* Filled by the script below once the visitor stops typing or changes the extension. */}
	<p
		class="domain-status"
		aria-live="polite"
		data-domain-status
		data-checking={t.domainStatus.checking}
		data-available={t.domainStatus.available}
		data-taken={t.domainStatus.taken}
		data-invalid={t.domainStatus.invalid}
		data-unknown={t.domainStatus.unknown}
	></p>
	<label>
		<span class="label-text">
			{t.notes} <span>{t.optional}</span>
		</span>
		<textarea name="notes" rows="3" placeholder={t.notesPlaceholder}></textarea>
	</label>
</div>

<script>
	import { domainName } from '../../scripts/order';
	import { domainAvailability, validDomainName, type DomainAvailability } from '../../scripts/domain-check';

	type Shown = DomainAvailability | 'checking' | '';

	document.querySelectorAll<HTMLElement>('.order-fields').forEach((fields) => {
		const input = fields.querySelector<HTMLInputElement>('input[name="domain"]');
		const suffix = fields.querySelector<HTMLElement>('[data-domain-suffix]');
		const status = fields.querySelector<HTMLElement>('[data-domain-status]');
		if (!input || !suffix || !status) return;
		let timer: number | undefined;
		let controller: AbortController | undefined;

		const show = (state: Shown, domain = '') => {
			status.dataset.state = state;
			status.textContent = state ? (status.dataset[state] ?? '').replace('{domain}', domain) : '';
			// A taken or malformed name blocks submitting; an unchecked one does not, so a registry outage never loses an order.
			input.setCustomValidity(state === 'taken' || state === 'invalid' ? status.textContent : '');
		};

		const check = () => {
			window.clearTimeout(timer);
			controller?.abort();
			const name = domainName(input.value);
			const extension = suffix.textContent?.trim() ?? '';
			if (!name || !extension) return show('');
			if (!validDomainName(name)) return show('invalid');
			const domain = `${name}${extension}`;
			show('checking', domain);
			timer = window.setTimeout(() => {
				const current = new AbortController();
				controller = current;
				domainAvailability(name, extension, current.signal)
					.then((result) => show(result, domain))
					.catch(() => undefined); // Aborted: a newer check is already running.
			}, 500);
		};

		input.addEventListener('input', check);
		// The parent rewrites the suffix when the extension or the package changes.
		new MutationObserver(check).observe(suffix, { childList: true, characterData: true, subtree: true });
	});
</script>

<style>
	.order-fields label {
		margin-bottom: 1rem;
		display: grid;
		gap: 0.4rem;
		color: var(--foreground);
		font-size: 0.8rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.label-text > span {
		color: var(--muted);
		font-weight: 400;
	}

	/* Inputs sit inside their label, so reset the label's weight instead of inheriting it. */
	.order-fields input,
	.order-fields textarea {
		width: 100%;
		min-height: 46px;
		padding: 0.7rem 0.9rem;
		color: var(--foreground);
		background: var(--card);
		border: 1px solid var(--input);
		border-radius: 12px;
		outline: none;
		font-size: 0.9rem;
		font-weight: 400;
		line-height: 1.5;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.order-fields textarea {
		resize: vertical;
	}

	.order-fields input::placeholder,
	.order-fields textarea::placeholder {
		color: #a39a93;
	}

	.order-fields input:hover,
	.order-fields textarea:hover,
	.domain-input:hover {
		border-color: #cfc4bb;
	}

	.order-fields input:focus,
	.order-fields textarea:focus {
		border-color: var(--ring);
		box-shadow: 0 0 0 3px rgba(255, 81, 0, 0.12);
	}

	.domain-input {
		display: flex;
		align-items: stretch;
		background: var(--card);
		border: 1px solid var(--input);
		border-radius: 12px;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.domain-input:focus-within {
		border-color: var(--ring);
		box-shadow: 0 0 0 3px rgba(255, 81, 0, 0.12);
	}

	.order-fields .domain-input input {
		min-width: 0;
		background: transparent;
		border: 0;
		box-shadow: none;
	}

	.domain-input span {
		padding: 0 0.85rem;
		display: flex;
		align-items: center;
		color: var(--muted);
		background: var(--background);
		border-left: 1px solid var(--input);
		border-radius: 0 11px 11px 0;
		font-size: 0.9rem;
		font-weight: 500;
	}

	.domain-status {
		margin: -0.6rem 0 1rem;
		color: var(--muted);
		font-size: 0.78rem;
		line-height: 1.5;
	}

	.domain-status:empty {
		display: none;
	}

	.domain-status[data-state='available'] {
		color: var(--success);
	}

	.domain-status[data-state='taken'],
	.domain-status[data-state='invalid'] {
		color: var(--destructive);
	}

	.order-fields:has(.domain-status[data-state='taken']) .domain-input,
	.order-fields:has(.domain-status[data-state='invalid']) .domain-input {
		border-color: var(--destructive);
	}

	@media (prefers-reduced-motion: reduce) {
		.order-fields input,
		.order-fields textarea,
		.domain-input {
			transition: none;
		}
	}
</style>
