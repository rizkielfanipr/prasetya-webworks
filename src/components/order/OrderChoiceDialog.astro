---
/** Asks whether to consult over WhatsApp first or pay online. Only rendered when the platform API is configured. */
import { content, type Locale } from '../../i18n/content';
import { site } from '../../config/site';
import { orderStatusPath } from '../../data/templates';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale].orderChoice;
---

{site.platformApiUrl && (
	<dialog
		class="order-choice"
		id="order-choice"
		aria-labelledby="order-choice-title"
		data-locale={locale}
		data-status-path={orderStatusPath(locale)}
		data-total-loading={t.totalLoading}
		data-paying={t.paying}
		data-error-invalid={t.errorInvalid}
		data-error-busy={t.errorBusy}
		data-error-unavailable={t.errorUnavailable}
	>
		<div class="choice-shell">
			<button class="choice-close" type="button" data-choice-close aria-label={t.close}>
				×
			</button>
			<h2 id="order-choice-title">{t.title}</h2>
			<p class="choice-intro">{t.description}</p>
			<p class="choice-total">
				<span>{t.totalLabel}</span>
				<strong data-choice-total />
			</p>
			<div class="choice-options">
				<section>
					<h3>{t.consultTitle}</h3>
					<p>{t.consultDescription}</p>
					<button class="choice-secondary" type="button" data-choice-consult>
						<i class="fa-brands fa-whatsapp" aria-hidden="true" />
						{t.consultAction}
					</button>
				</section>
				<section>
					<h3>{t.payTitle}</h3>
					<p>{t.payDescription}</p>
					<button class="choice-primary" type="button" data-choice-pay>
						{t.payAction}
					</button>
				</section>
			</div>
			<p class="choice-error" role="alert" data-choice-error />
			<p class="choice-note">{t.domainNote}</p>
		</div>
	</dialog>
)}

<style>
	.order-choice {
		width: min(720px, calc(100% - 2rem));
		max-height: calc(100dvh - 2rem);
		padding: 0;
		overflow: auto;
		color: var(--foreground);
		background: var(--card);
		border: 0;
		border-radius: var(--radius);
		box-shadow: 0 32px 90px rgba(90, 35, 10, 0.24);
	}

	.order-choice::backdrop {
		background: rgba(15, 23, 42, 0.62);
	}

	.choice-shell {
		position: relative;
		padding: clamp(1.5rem, 4vw, 2.5rem);
	}

	.choice-close {
		position: absolute;
		top: 0.9rem;
		right: 0.9rem;
		width: 38px;
		height: 38px;
		display: grid;
		place-items: center;
		color: var(--foreground);
		background: var(--card);
		border: 1px solid var(--border);
		border-radius: 50%;
		cursor: pointer;
		font-size: 1.25rem;
		line-height: 1;
	}

	.order-choice h2 {
		margin: 0;
		padding-right: 2.5rem;
		font-family: var(--font-display);
		font-size: clamp(1.4rem, 3vw, 1.8rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.2;
	}

	.choice-intro {
		margin: 0.6rem 0 1.25rem;
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.choice-total {
		margin: 0 0 1.25rem;
		padding: 0.85rem 1rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		background: var(--secondary);
		border-radius: 12px;
		font-size: 0.88rem;
	}

	.choice-total strong {
		font-size: 1.1rem;
	}

	.choice-options {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.85rem;
	}

	.choice-options section {
		padding: 1.15rem;
		display: flex;
		flex-direction: column;
		border: 1px solid var(--border);
		border-radius: 12px;
	}

	.choice-options h3 {
		margin: 0;
		font-size: 1rem;
	}

	.choice-options p {
		flex: 1;
		margin: 0.4rem 0 1rem;
		color: var(--muted);
		font-size: 0.84rem;
		line-height: 1.55;
	}

	.choice-primary,
	.choice-secondary {
		min-height: 46px;
		padding: 0.6rem 1rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		border-radius: 12px;
		cursor: pointer;
		font: inherit;
		font-size: 0.88rem;
		font-weight: 600;
	}

	.choice-primary {
		color: var(--primary-foreground);
		background: var(--primary);
		border: 1px solid var(--primary);
	}

	.choice-primary:hover:not(:disabled) {
		background: var(--blue-hover);
	}

	.choice-primary:disabled {
		cursor: not-allowed;
		opacity: 0.6;
	}

	.choice-secondary {
		color: var(--foreground);
		background: var(--card);
		border: 1px solid var(--border);
	}

	.choice-secondary:hover {
		border-color: var(--primary);
	}

	.choice-close:focus-visible,
	.choice-primary:focus-visible,
	.choice-secondary:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	.choice-error {
		margin: 0.85rem 0 0;
		color: var(--destructive);
		font-size: 0.85rem;
		font-weight: 600;
	}

	.choice-error:empty {
		display: none;
	}

	.choice-note {
		margin: 0.85rem 0 0;
		color: var(--muted);
		font-size: 0.8rem;
		line-height: 1.55;
	}

	@media (max-width: 560px) {
		.choice-options {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
