---
import Layout from '../layouts/Layout.astro';
import SiteFooter from './SiteFooter.astro';
import TemplateCard from './TemplateCard.astro';
import { content, type Locale } from '../i18n/content';
import { CATALOG_PAGE_SIZE, catalogItems, catalogPageCount, catalogPath, homePath, templateCategories, templateRequestPath, type TemplateCategory } from '../data/templates';

interface Props {
	locale: Locale;
	category?: TemplateCategory;
	/** 1-based page number. */
	page?: number;
}

const { locale, category, page = 1 } = Astro.props;
const t = content[locale];
const c = t.catalog;
const totalPages = catalogPageCount(category);
const items = catalogItems(category).slice((page - 1) * CATALOG_PAGE_SIZE, page * CATALOG_PAGE_SIZE);
const categoryLabel = category ? t.templateCategories[category] : undefined;
const catalogTitle = `${c.title} ${c.emphasis}`;
const pageLabel = c.pageLabel.replace('{page}', String(page));
const home = homePath(locale);
const filters = [
	{ href: catalogPath(locale), label: t.templatesIntro.all, active: !category },
	...templateCategories.map((key) => ({ href: catalogPath(locale, key), label: t.templateCategories[key], active: key === category })),
];
const languages = (['id', 'en'] as Locale[]).map((code) => ({ code, label: code.toUpperCase(), href: catalogPath(code, category, page), active: code === locale }));

// Pager: first, last, and the current page with its neighbours; gaps become an ellipsis. Links jump back to the list.
const pageHref = (n: number) => `${catalogPath(locale, category, n)}#catalog-list`;
const shownPages = [...new Set([1, page - 1, page, page + 1, totalPages])].filter((n) => n >= 1 && n <= totalPages).sort((a, b) => a - b);
const pagerItems = shownPages.flatMap((n, index) => (index > 0 && n - shownPages[index - 1] > 1 ? ['gap', n] : [n])) as (number | 'gap')[];
---

<Layout
	lang={locale}
	title={`${categoryLabel ? c.metaTitleCategory.replace('{category}', categoryLabel) : c.metaTitle}${page > 1 ? ` — ${pageLabel}` : ''} — Prasetya Webworks`}
	description={c.description}
	alternates={{ id: catalogPath('id', category, page), en: catalogPath('en', category, page) }}
>
	<header class="catalog-header" id="top">
		<a class="brand" href={home} aria-label={`Prasetya Webworks — ${c.home}`}><img src="/images/prasetya-webworks-logo.png" alt="Prasetya Webworks" width="260" height="90" /></a>
		<div class="header-actions">
			<nav class="language-switcher" aria-label="Language">{languages.map((language, index) => <>{index > 0 && <span aria-hidden="true">/</span>}<a class:list={{ active: language.active }} href={language.href} aria-current={language.active ? 'page' : undefined}>{language.label}</a></>)}</nav>
			<a class="header-cta" href={`${home}#contact`}><i class="fa-brands fa-whatsapp" aria-hidden="true"></i><span>{t.nav.consultation}</span></a>
		</div>
	</header>

	<main class="catalog">
		<nav class="breadcrumb" aria-label={c.breadcrumb}>
			<a href={home}>{c.home}</a><span aria-hidden="true">/</span>
			{category ? <><a href={catalogPath(locale)}>{catalogTitle}</a><span aria-hidden="true">/</span><span aria-current="page">{categoryLabel}</span></> : <span aria-current="page">{catalogTitle}</span>}
		</nav>

		<div class="catalog-intro">
			{category ? <h1><em>{categoryLabel}</em></h1> : <h1>{c.title} <em>{c.emphasis}</em></h1>}
			<p>{c.description}</p>
		</div>

		<nav class="catalog-filters" id="catalog-list" aria-label={t.templatesIntro.filterLabel}>
			{filters.map((filter) => <a class="catalog-filter" href={filter.href} aria-current={filter.active ? 'page' : undefined}>{filter.label}</a>)}
		</nav>

		<div class="catalog-grid">{items.map((item) => <TemplateCard item={item} locale={locale} href={templateRequestPath(locale, item)} />)}</div>

		{totalPages > 1 && (
			<nav class="catalog-pager" aria-label={c.pagination}>
				{page > 1 ? <a class="pager-step" href={pageHref(page - 1)} rel="prev"><span aria-hidden="true">‹</span> <span class="pager-label">{c.previous}</span></a> : <span class="pager-step" aria-hidden="true"><span>‹</span> <span class="pager-label">{c.previous}</span></span>}
				<ol>
					{pagerItems.map((item) => item === 'gap'
						? <li class="pager-gap" aria-hidden="true">…</li>
						: <li><a class="pager-number" href={pageHref(item)} aria-current={item === page ? 'page' : undefined} aria-label={c.pageOf.replace('{page}', String(item)).replace('{total}', String(totalPages))}>{item}</a></li>)}
				</ol>
				{page < totalPages ? <a class="pager-step" href={pageHref(page + 1)} rel="next"><span class="pager-label">{c.next}</span> <span aria-hidden="true">›</span></a> : <span class="pager-step" aria-hidden="true"><span class="pager-label">{c.next}</span> <span>›</span></span>}
			</nav>
		)}

		<section class="catalog-cta" aria-labelledby="catalog-cta-title">
			<h2 id="catalog-cta-title">{c.ctaTitle}</h2>
			<p>{c.ctaText}</p>
			<a href={`${home}#contact`}>{t.hero.primary} <span aria-hidden="true">↗</span></a>
		</section>
	</main>

	<SiteFooter locale={locale} home={home} />
</Layout>

<style>
	.catalog-header { position:sticky; top:0; z-index:30; height:74px; padding:0 clamp(1.2rem,4vw,4.5rem); display:flex; justify-content:space-between; align-items:center; color:#fff; background:rgba(7,7,7,.92); border-bottom:1px solid rgba(255,255,255,.12); backdrop-filter:blur(16px); }
	.brand { width:132px; height:48px; display:flex; align-items:center; filter:invert(1); }.brand img { width:100%; height:100%; object-fit:contain; object-position:left center; }
	.header-actions { display:flex; align-items:center; gap:.85rem; }
	.language-switcher { padding:.34rem .5rem; display:flex; align-items:center; gap:.35rem; color:rgba(255,255,255,.52); border:1px solid rgba(255,255,255,.18); border-radius:999px; font-size:.6rem; }.language-switcher a { color:inherit; text-decoration:none; }.language-switcher a:hover,.language-switcher .active { color:#fff; }.language-switcher .active { font-weight:700; }
	.header-cta { padding:.75rem 1.1rem; display:inline-flex; align-items:center; gap:.55rem; color:#fff; background:var(--blue); border-radius:999px; font-size:.64rem; letter-spacing:.1em; text-decoration:none; text-transform:uppercase; transition:background .2s; }.header-cta:hover { background:var(--blue-deep); }.header-cta i { font-size:.95rem; }

	.catalog { max-width:1320px; margin:auto; padding:2.2rem clamp(1.25rem,4vw,2rem) 5rem; }
	.breadcrumb { display:flex; flex-wrap:wrap; gap:.5rem; color:var(--muted); font-size:.66rem; letter-spacing:.06em; }.breadcrumb a { color:var(--blue); text-decoration:none; }.breadcrumb a:hover { text-decoration:underline; }.breadcrumb [aria-current] { color:var(--ink); }
	.catalog-intro { max-width:720px; margin:3rem auto 2.4rem; text-align:center; }.catalog-intro h1 { margin:0; color:var(--ink); font-family:Georgia,serif; font-size:clamp(2.2rem,5vw,3.6rem); font-weight:400; letter-spacing:-.04em; line-height:1; }.catalog-intro em { color:var(--blue); }.catalog-intro p { margin:1rem auto 0; color:var(--muted); font-size:.85rem; line-height:1.6; }
	.catalog-filters { margin-bottom:2rem; display:flex; flex-wrap:wrap; justify-content:center; gap:.5rem; }.catalog-filter { flex:none; padding:.6rem .95rem; display:inline-flex; align-items:center; gap:.45rem; color:var(--ink); background:rgba(255,253,248,.78); border:1px solid var(--line); border-radius:999px; font-size:.68rem; letter-spacing:.03em; text-decoration:none; transition:background .2s,border-color .2s,color .2s; }.catalog-filter:hover { border-color:var(--blue); }.catalog-filter[aria-current] { color:#fff; background:var(--blue); border-color:var(--blue); }
	.catalog-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.3rem; }
	.catalog-pager { margin-top:2.6rem; display:flex; justify-content:center; align-items:center; gap:.75rem; flex-wrap:wrap; }.catalog-pager ol { margin:0; padding:0; display:flex; align-items:center; gap:.35rem; list-style:none; }
	.pager-number,.pager-step { min-width:2.4rem; height:2.4rem; padding:0 .85rem; display:inline-flex; justify-content:center; align-items:center; gap:.4rem; color:var(--ink); background:var(--paper); border:1px solid var(--line); border-radius:999px; font-size:.68rem; letter-spacing:.04em; text-decoration:none; transition:background .2s,border-color .2s,color .2s; }
	.pager-number { padding:0; }a.pager-number:hover,a.pager-step:hover { color:var(--blue); border-color:var(--blue); }.pager-number[aria-current] { color:#fff; background:var(--blue); border-color:var(--blue); }
	span.pager-step { color:var(--line); }.pager-gap { padding:0 .2rem; color:var(--muted); font-size:.7rem; }
	.pager-number:focus-visible,.pager-step:focus-visible { outline:3px solid var(--blue-soft); outline-offset:2px; }
	.catalog-cta { margin-top:4rem; padding:clamp(2rem,5vw,3.2rem); color:#fff; background:linear-gradient(135deg,#10131d,var(--blue-deep)); border-radius:28px; text-align:center; }.catalog-cta h2 { margin:0; font-family:Georgia,serif; font-size:clamp(1.6rem,3vw,2.2rem); font-weight:400; }.catalog-cta p { max-width:520px; margin:.8rem auto 1.6rem; color:#c5cbe0; font-size:.8rem; line-height:1.6; }.catalog-cta a { padding:.95rem 1.4rem; display:inline-flex; gap:1rem; color:var(--ink); background:#fff; border-radius:999px; font-size:.66rem; letter-spacing:.08em; text-decoration:none; text-transform:uppercase; }.catalog-cta a:hover { background:var(--blue-soft); }
	.catalog-filter:focus-visible,.catalog-cta a:focus-visible,.header-cta:focus-visible,.breadcrumb a:focus-visible { outline:3px solid var(--blue-soft); outline-offset:2px; }
	@media (max-width:1000px) { .catalog-grid { grid-template-columns:repeat(2,1fr); } }
	@media (max-width:560px) { .catalog-pager { flex-wrap:nowrap; gap:.25rem; }.catalog-pager ol { gap:.2rem; }.pager-number,.pager-step { min-width:2.1rem; height:2.1rem; padding:0; }.pager-label { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }.catalog-filters { gap:.4rem; }.catalog-filter { padding:.5rem .8rem; font-size:.64rem; }.catalog-header { height:66px; }.brand { width:115px; }.header-cta span { display:none; }.header-cta { padding:.7rem; }.catalog-grid { grid-template-columns:1fr; }.catalog-intro { margin-top:2rem; } }
</style>
