---
import { content, type Locale } from '../../i18n/content';
import { livePreviewUrl, orderPath, type TemplateCategory, type TemplateItem } from '../../data/templates';

interface Props {
	item: TemplateItem;
	locale: Locale;
	hidden?: boolean;
}

const { item, locale, hidden = false } = Astro.props;
const t = content[locale].templatesIntro;
const preview = livePreviewUrl(item);
---

{/* data-card-* hooks let the catalog search fill a copy of this card for any template. */}
<article class="template-card" data-category={item.category} hidden={hidden}>
	<div class="template-screen">
		{item.thumbnail ? (
			<img
				src={`/images/templates/${item.code}.webp`}
				alt={t.thumbAlt.replace('{name}', item.name)}
				width="640"
				height="400"
				loading="lazy"
				decoding="async"
				data-card-image
			/>
		) : (
			<span class="template-placeholder" data-card-image>
				{item.name}
			</span>
		)}
		<span class="template-index" data-card-code>
			#{item.code}
		</span>
	</div>
	<div class="template-meta">
		<span class="template-category" data-card-category>
			{content[locale].templateCategories[item.category as TemplateCategory]}
		</span>
		<h3 data-card-name>{item.name}</h3>
		<p data-card-meta>
			{item.type} · {item.pages} {t.pages}
		</p>
		<div class="template-actions">
			{preview && (
				<a
					class="template-preview"
					data-card-preview
					href={preview}
					target="_blank"
					rel="noopener"
					aria-label={t.livePreviewLabel.replace('{name}', item.name)}
				>
					{t.livePreview} <span aria-hidden="true">↗</span>
				</a>
			)}
			{/* "Choose template" opens the order form with this template already chosen. */}
			<a class="template-select" href={orderPath(locale, item.code)} data-card-select>
				{t.select} <span aria-hidden="true">↗</span>
			</a>
		</div>
	</div>
</article>

<style>
	.template-card {
		overflow: hidden;
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		box-shadow: none;
		transition:
			transform 0.25s,
			box-shadow 0.25s;
	}

	.template-card:hover {
		transform: translateY(-6px);
		border-color: rgba(255, 81, 0, 0.48);
		box-shadow: 0 16px 32px rgba(120, 55, 20, 0.1);
	}

	.template-card[hidden] {
		display: none;
	}

	.template-screen {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--secondary);
		border-radius: calc(var(--radius) - 3px) calc(var(--radius) - 3px) 0 0;
	}

	.template-screen img {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		object-position: top;
		transition: transform 0.5s ease;
	}

	.template-card:hover .template-screen img {
		transform: scale(1.03);
	}

	/* Shown when a kit has no screenshot. */
	.template-placeholder {
		height: 100%;
		display: grid;
		place-items: center;
		padding: 1rem;
		color: var(--blue-deep);
		font-family: var(--font-serif);
		font-size: 1.6rem;
		text-align: center;
	}

	.template-index {
		position: absolute;
		right: 0.7rem;
		bottom: 0.6rem;
		z-index: 3;
		padding: 0.2rem 0.5rem;
		color: #fff;
		background: rgba(17, 19, 26, 0.62);
		border-radius: 8px;
		font-size: 0.58rem;
		letter-spacing: 0.06em;
	}

	.template-meta {
		padding: 1.1rem;
		text-align: center;
	}

	.template-meta h3 {
		margin: 0 0 0.35rem;
		color: var(--ink);
		font-family: var(--font-serif);
		font-size: 1rem;
		font-weight: 400;
	}

	.template-meta p {
		margin: 0;
		color: var(--muted);
		font-size: 0.67rem;
		line-height: 1.45;
	}

	.template-category {
		display: block;
		margin-bottom: 0.45rem;
		color: var(--blue);
		font-size: 0.58rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.template-actions {
		margin-top: 0.95rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
	}

	.template-select,
	.template-preview {
		padding: 0.55rem 0.95rem;
		display: inline-flex;
		gap: 0.6rem;
		border: 1px solid var(--blue);
		border-radius: 12px;
		font: inherit;
		font-size: 0.62rem;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
		cursor: pointer;
		transition:
			background 0.2s,
			color 0.2s,
			border-color 0.2s;
	}

	.template-select {
		color: var(--blue);
		background: transparent;
	}

	.template-select:hover {
		color: var(--primary-foreground);
		background: var(--blue);
	}

	.template-preview {
		color: var(--primary-foreground);
		background: var(--blue);
	}

	.template-preview:hover {
		background: var(--blue-deep);
		border-color: var(--blue-deep);
	}

	.template-select:focus-visible,
	.template-preview:focus-visible {
		outline: 3px solid var(--blue-soft);
		outline-offset: 2px;
	}

	.template-select span,
	.template-preview span {
		transition: transform 0.25s ease;
	}

	.template-select:hover span,
	.template-preview:hover span {
		transform: translate3d(3px, -2px, 0);
	}

	@media (prefers-reduced-motion: reduce) {
		.template-card,
		.template-screen img,
		.template-select span,
		.template-preview span {
			transition: none;
		}
	}
</style>
